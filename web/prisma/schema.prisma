generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WebhookDeliveryStatus {
  pending
  dispatching
  delivered
  failed_retryable
  failed_terminal
  canceled
}

enum WebhookAttemptOutcome {
  success
  retryable_failure
  terminal_failure
}

enum WebhookFailureDomain {
  destination
  security
  configuration
  platform_internal
}

enum WebhookFailureCode {
  none
  timeout
  connection_refused
  connection_reset
  host_unreachable
  network_unreachable
  dns_temporary
  dns_not_found
  http_3xx_redirect_blocked
  http_408
  http_425
  http_429
  http_5xx
  http_4xx_non_retryable
  ssrf_blocked
  tls_certificate_error
  invalid_url
  endpoint_disabled
  endpoint_deleted
  internal_transient
  internal_persistent
}

enum OpsBackupRestoreRunStatus {
  started
  completed
  failed
  indeterminate
}

enum OpsBackupRestoreMaintenanceRunStatus {
  running
  completed
  failed
}

enum OpsBackupRestoreRetentionRunStatus {
  running
  completed
  failed
}

enum AppointmentReminderType {
  appointment
  follow_up
  maintenance
}

enum NotificationType {
  appointment
  follow_up
  maintenance
}

enum ImageAssetStorageState {
  pending_upload
  available
  delete_pending
  deleted
  quarantined
}

enum BillingProvider {
  stripe
}

enum BillingSubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum BillingPaymentStatus {
  pending
  succeeded
  failed
  refunded
  disputed
}

enum BillingWebhookEventStatus {
  received
  processing
  processed
  ignored_out_of_order
  ignored_unsupported
  failed_retryable
  failed_terminal
}

model User {
  id                            String                         @id @default(uuid())
  email                         String                         @unique
  passwordHash                  String
  role                          String
  locale                        String
  // M26: null means unverified. No @default here on purpose -- every row
  // that exists before the M26 migration is explicitly backfilled to a
  // real, non-null timestamp by that migration itself; every row created
  // afterward starts genuinely null until the owner completes email
  // verification. A column default would blur that distinction.
  emailVerifiedAt               DateTime?
  createdAt                     DateTime                       @default(now())
  sessions                      Session[]
  clients                       Client[]
  analyses                      Analysis[]
  consultations                 Consultation[]
  appointments                  Appointment[]
  notifications                 Notification[]
  webhooks                      WebhookEndpoint[]
  billingCustomers              BillingCustomer[]
  billingSubscriptions          BillingSubscription[]
  billingPayments               BillingPayment[]
  imageAnalysisProviderAttempts ImageAnalysisProviderAttempt[]
  videoLessons                  VideoLesson[]
  emailNotifications            EmailNotification[]
  authTokens                    AuthToken[]
}

model Session {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenPurpose {
  email_verification
  password_reset
}

// M26: the raw token is never persisted, only its SHA-256 hash. At most one
// unused row may exist per (userId, purpose) at a time -- issuing a new
// token for the same user+purpose deletes any prior unused one first, so
// there is never more than one active token to guess against.
model AuthToken {
  id        String            @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  tokenHash String            @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model Client {
  id            String         @id @default(uuid())
  ownerUserId   String
  fullName      String         @db.VarChar(200)
  email         String?        @db.VarChar(320)
  phone         String?        @db.VarChar(40)
  notes         String?        @db.VarChar(4000)
  deletedAt     DateTime?      @db.Timestamp(6)
  createdAt     DateTime       @default(now()) @db.Timestamp(6)
  updatedAt     DateTime       @updatedAt @db.Timestamp(6)
  owner         User           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  analyses      Analysis[]
  consultations Consultation[]
  appointments  Appointment[]

  @@unique([id, ownerUserId])
  @@index([ownerUserId, deletedAt, updatedAt, id])
}

model Analysis {
  id                   String         @id
  clientId             String
  ownerUserId          String
  goal                 String
  hairType             String
  density              String
  porosity             String
  phase                String
  clarificationRound   Int
  confidenceScore      Float
  uncertaintyReasons   Json
  followUpQuestions    Json
  recommendations      Json
  safetyNotes          Json
  faceShape            String?
  headShape            String?
  hairLength           String?
  hairTexture          String?
  hairCondition        String?
  growthPattern        String?
  targetShape          String?
  technicalCutPlan     Json?
  clarificationAnswers Json
  imageAssetId         String?
  imageAnalysisId      String?
  m8DraftCreatedAt     DateTime?
  m8FinalizedAt        DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  owner                User           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client               Client         @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  imageAsset           ImageAsset?    @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  imageAnalysis        ImageAnalysis? @relation(fields: [imageAnalysisId], references: [id], onDelete: SetNull)
  consultations        Consultation[]

  @@unique([id, ownerUserId, clientId])
  @@index([ownerUserId])
  @@index([clientId])
  @@index([ownerUserId, clientId])
  @@index([imageAssetId])
  @@index([imageAnalysisId])
}

model Consultation {
  id          String   @id @default(uuid())
  ownerUserId String
  clientId    String
  analysisId  String
  summary     String   @db.VarChar(4000)
  nextSteps   Json     @default("[]")
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  client      Client   @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  analysis    Analysis @relation(fields: [analysisId, ownerUserId, clientId], references: [id, ownerUserId, clientId], onDelete: Restrict)

  @@index([ownerUserId, createdAt, id])
  @@index([ownerUserId, clientId, createdAt, id])
  @@index([analysisId, ownerUserId, clientId])
}

model Appointment {
  id                    String                  @id @default(uuid())
  ownerUserId           String
  clientId              String
  title                 String                  @db.VarChar(200)
  startsAt              DateTime                @db.Timestamp(6)
  reminderMinutesBefore Int                     @default(1440)
  reminderType          AppointmentReminderType
  reminderSentAt        DateTime?               @db.Timestamp(6)
  notes                 String                  @default("") @db.VarChar(4000)
  createdAt             DateTime                @default(now()) @db.Timestamp(6)
  updatedAt             DateTime                @updatedAt @db.Timestamp(6)
  owner                 User                    @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client                Client                  @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  notifications         Notification[]

  @@unique([id, ownerUserId, clientId])
  @@index([ownerUserId, startsAt, id])
  @@index([ownerUserId, clientId, startsAt, id])
  @@index([ownerUserId, reminderSentAt, startsAt, id])
}

model Notification {
  id                   String           @id @default(uuid())
  ownerUserId          String
  type                 NotificationType
  title                String           @db.VarChar(240)
  message              String           @db.VarChar(1000)
  relatedClientId      String
  relatedAppointmentId String
  createdAt            DateTime         @default(now()) @db.Timestamp(6)
  readAt               DateTime?        @db.Timestamp(6)
  owner                User             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relatedAppointment   Appointment      @relation(fields: [relatedAppointmentId, ownerUserId, relatedClientId], references: [id, ownerUserId, clientId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([relatedAppointmentId, ownerUserId, type])
  @@index([ownerUserId, createdAt, id])
  @@index([ownerUserId, readAt, createdAt, id])
}

model ImageAsset {
  id                    String          @id @default(uuid())
  fileName              String
  mimeType              String
  sizeBytes             Int
  ownerUserId           String
  clientId              String
  storagePath           String
  storageBackend        String?                 @db.VarChar(16)
  storageBucketAlias    String?                 @db.VarChar(64)
  storageKey            String?                 @db.VarChar(512)
  storageVersionId      String?                 @db.VarChar(1024)
  storageEtag           String?                 @db.VarChar(256)
  contentSha256         String?                 @db.Char(64)
  storageState          ImageAssetStorageState?
  storageMigratedAt     DateTime?               @db.Timestamp(6)
  objectDeletedAt       DateTime?               @db.Timestamp(6)
  lastStorageErrorCode  String?                 @db.VarChar(80)
  exifStripped          Boolean         @default(false)
  normalizedOrientation Int             @default(0)
  uploadedAt            DateTime        @default(now())
  deletedAt             DateTime?
  retentionDeletesAt    DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  analyses              ImageAnalysis[]
  analysisResults       Analysis[]

  @@index([ownerUserId])
  @@index([clientId])
  @@index([ownerUserId, clientId])
  @@index([deletedAt])
  @@unique([storageBucketAlias, storageKey])
  @@index([ownerUserId, storageState, id])
  @@index([storageState, retentionDeletesAt, id])
}

model ImageAnalysis {
  id                         String                         @id @default(uuid())
  assetId                    String
  status                     String                         @default("draft")
  providerName               String                         @default("manual-only")
  modelVersion               String                         @default("mock-1.0")
  analysisPayload            Json                           @default("{}")
  confidences                Json                           @default("{}")
  unknownFields              Json                           @default("[]")
  warnings                   Json                           @default("[]")
  limitations                Json                           @default("[]")
  consentTimestamp           DateTime                       @default(now())
  externalAiConsentGrantedAt DateTime?                      @db.Timestamp(6)
  externalAiConsentVersion   String?                        @db.VarChar(32)
  lastFailureCode            String?                        @db.VarChar(80)
  deletedAt                  DateTime?
  retentionDeletesAt         DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  asset                      ImageAsset                     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reviews                    ImageAnalysisReview[]
  analysisResults            Analysis[]
  providerAttempts           ImageAnalysisProviderAttempt[]

  @@index([assetId])
  @@index([status])
  @@index([deletedAt])
}

model ImageAnalysisProviderAttempt {
  id              String   @id @default(cuid())
  imageAnalysisId String
  ownerUserId     String
  providerName    String   @db.VarChar(64)
  modelVersion    String   @db.VarChar(64)
  attemptNumber   Int
  createdAt       DateTime @default(now()) @db.Timestamp(6)

  imageAnalysis ImageAnalysis @relation(fields: [imageAnalysisId], references: [id], onDelete: Cascade)
  owner         User          @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([imageAnalysisId, attemptNumber])
  @@index([ownerUserId, createdAt])
  @@index([imageAnalysisId])
}

model VideoLesson {
  id                   String   @id @default(uuid())
  ownerUserId          String
  topic                String   @db.VarChar(200)
  level                String   @db.VarChar(20)
  locale               String   @db.VarChar(5)
  status               String   @default("not_generated") @db.VarChar(20)
  recommendedLessonIds Json     @default("[]")
  script               String?  @db.VarChar(4000)
  videoUrl             String?  @db.VarChar(2048)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ownerUserId])
}

enum EmailCategory {
  transactional
  security
  onboarding
  product
  billing
  administrative
}

enum EmailDeliveryStatus {
  pending
  sent
  failed
  skipped
}

// M25: metadata-only delivery ledger. The rendered email body is
// deliberately never stored (see subject-only below) -- it is
// regenerable from the same template + input data, and persisting full
// bodies indefinitely would be an unproven retention/privacy liability.
// A notification must never stay "pending" once its synchronous send
// attempt has completed -- it always resolves to sent/failed/skipped.
model EmailNotification {
  id                 String              @id @default(cuid())
  ownerUserId        String
  category           EmailCategory
  eventType          String              @db.VarChar(120)
  recipientEmail     String              @db.VarChar(320)
  subject            String              @db.VarChar(255)
  status             EmailDeliveryStatus @default(pending)
  idempotencyKey     String              @db.VarChar(200)
  providerMessageId  String?             @db.VarChar(255)
  failureCode        String?             @db.VarChar(80)
  failureMessageSafe String?             @db.VarChar(500)
  attemptCount       Int                 @default(0)
  relatedEntityType  String?             @db.VarChar(40)
  relatedEntityId    String?
  createdAt          DateTime            @default(now()) @db.Timestamp(6)
  sentAt             DateTime?           @db.Timestamp(6)
  updatedAt          DateTime            @updatedAt @db.Timestamp(6)

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([idempotencyKey])
  @@index([ownerUserId, createdAt])
  @@index([status, createdAt])
  @@index([category])
}

model ImageAnalysisReview {
  id                    String        @id @default(uuid())
  analysisId            String
  reviewedByUserId      String
  manualCorrections     Json          @default("{}")
  confirmationTimestamp DateTime?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  analysis              ImageAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([reviewedByUserId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String   @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  status       String
  metadata     Json
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
  @@index([status])
  @@index([actorUserId, createdAt])
}

model OpsBackupSnapshot {
  id                String   @id @default(cuid())
  ownerUserId       String   @db.Uuid
  label             String   @db.VarChar(120)
  snapshotJson      Json
  checksum          String   @db.VarChar(64)
  checksumAlgorithm String   @db.VarChar(32)
  schemaVersion     String   @db.VarChar(16)
  createdByUserId   String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamp(6)

  @@index([ownerUserId, createdAt])
}

model OpsBackupRestoreRun {
  id                               String                    @id @default(cuid())
  ownerUserId                      String                    @db.Uuid
  backupId                         String                    @db.VarChar(120)
  actorUserId                      String                    @db.Uuid
  correlationRequestId             String                    @db.VarChar(120)
  strategy                         String                    @db.VarChar(32)
  previewFingerprint               String                    @db.VarChar(64)
  currentStateFingerprint          String                    @db.VarChar(64)
  status                           OpsBackupRestoreRunStatus
  attemptCount                     Int                       @default(0)
  maxAttempts                      Int                       @default(3)
  startedAt                        DateTime                  @db.Timestamp(6)
  finishedAt                       DateTime?                 @db.Timestamp(6)
  finalErrorCode                   String?                   @db.VarChar(80)
  deletedClientCount               Int?
  deletedAnalysisCount             Int?
  deletedImageAssetCount           Int?
  deletedImageAnalysisCount        Int?
  deletedImageAnalysisReviewCount  Int?
  restoredClientCount              Int?
  restoredAnalysisCount            Int?
  restoredImageAssetCount          Int?
  restoredImageAnalysisCount       Int?
  restoredImageAnalysisReviewCount Int?
  warningCodes                     Json?
  createdAt                        DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt                        DateTime                  @updatedAt @db.Timestamp(6)

  @@index([ownerUserId, startedAt, id])
  @@index([ownerUserId, status, startedAt, id])
  @@index([ownerUserId, status, finishedAt, id])
  @@index([ownerUserId, backupId, startedAt, id])
  @@index([ownerUserId, correlationRequestId, startedAt, id])
}

model OpsBackupRestoreMaintenanceRun {
  id                                String                               @id @default(cuid())
  ownerUserId                       String                               @db.Uuid
  actorUserId                       String                               @db.Uuid
  status                            OpsBackupRestoreMaintenanceRunStatus
  staleThresholdMinutes             Int
  evaluationTime                    DateTime                             @db.Timestamp(6)
  maintenanceFingerprint            String                               @db.VarChar(64)
  executionIdempotencyKey           String                               @db.VarChar(190)
  idempotencyFingerprint            String                               @db.VarChar(64)
  advisoryLockKey                   String                               @db.VarChar(32)
  candidatesScanned                 Int                                  @default(0)
  candidatesReconciledIndeterminate Int                                  @default(0)
  finalErrorCode                    String?                              @db.VarChar(80)
  startedAt                         DateTime                             @db.Timestamp(6)
  finishedAt                        DateTime?                            @db.Timestamp(6)
  createdAt                         DateTime                             @default(now()) @db.Timestamp(6)
  updatedAt                         DateTime                             @updatedAt @db.Timestamp(6)

  @@unique([ownerUserId, executionIdempotencyKey])
  @@index([ownerUserId, status, startedAt])
  @@index([ownerUserId, status, finishedAt, id])
  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, evaluationTime])
}

model OpsBackupRestoreRetentionRun {
  id                           String                             @id @default(cuid())
  ownerUserId                  String                             @db.Uuid
  actorUserId                  String                             @db.Uuid
  status                       OpsBackupRestoreRetentionRunStatus
  policyVersion                String                             @db.VarChar(32)
  batchLimit                   Int
  evaluationTime               DateTime                           @db.Timestamp(6)
  retentionFingerprint         String                             @db.VarChar(64)
  executionIdempotencyKey      String                             @db.VarChar(190)
  idempotencyFingerprint       String                             @db.VarChar(64)
  advisoryLockKey              String                             @db.VarChar(32)
  candidateRestoreRunCount     Int                                @default(0)
  candidateMaintenanceRunCount Int                                @default(0)
  deletedRestoreRunCount       Int                                @default(0)
  deletedMaintenanceRunCount   Int                                @default(0)
  finalErrorCode               String?                            @db.VarChar(80)
  startedAt                    DateTime                           @db.Timestamp(6)
  finishedAt                   DateTime?                          @db.Timestamp(6)
  createdAt                    DateTime                           @default(now()) @db.Timestamp(6)
  updatedAt                    DateTime                           @updatedAt @db.Timestamp(6)

  @@unique([ownerUserId, executionIdempotencyKey])
  @@index([ownerUserId, status, startedAt])
  @@index([ownerUserId, evaluationTime])
  @@index([ownerUserId, createdAt])
}

model OpsRetentionRun {
  id                      String    @id @default(cuid())
  ownerUserId             String    @db.Uuid
  mode                    String    @db.VarChar(16)
  status                  String    @db.VarChar(32)
  olderThanDays           Int
  reasonAuditSafe         String?   @db.VarChar(200)
  executionIdempotencyKey String?   @db.VarChar(190)
  idempotencyFingerprint  String?   @db.VarChar(64)
  advisoryLockKey         String    @db.VarChar(32)
  startedAt               DateTime  @db.Timestamp(6)
  finishedAt              DateTime? @db.Timestamp(6)
  pushQueueAffected       Int
  auditEventsAffected     Int
  errorCode               String?   @db.VarChar(80)
  errorMessageSafe        String?   @db.VarChar(500)
  createdAt               DateTime  @default(now()) @db.Timestamp(6)

  @@unique([ownerUserId, executionIdempotencyKey])
  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, startedAt])
}

model OpsPushQueueEntry {
  id          String    @id @default(cuid())
  ownerUserId String    @db.Uuid
  channel     String    @db.VarChar(16)
  title       String    @db.VarChar(160)
  body        String    @db.Text
  status      String    @db.VarChar(16)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)

  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, status])
}

model WebhookEndpoint {
  id              String    @id @default(cuid())
  ownerUserId     String
  owner           User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name            String    @db.VarChar(255)
  url             String    @db.VarChar(2048)
  // Deprecated compatibility field retained only for M9D route compatibility.
  // M10A introduces WebhookEndpointSecretVersion.secretEncrypted as the forward-compatible
  // source of truth for secret material. This legacy column is planned for removal only
  // after all routes have migrated to the versioned secret model in a later milestone.
  secretEncrypted String    @db.Text
  enabled         Boolean   @default(true)
  deletedAt       DateTime? @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @db.Timestamp(6)

  secretVersions WebhookEndpointSecretVersion[]
  deliveries     WebhookDelivery[]

  @@unique([ownerUserId, name])
  @@unique([id, ownerUserId])
  @@index([ownerUserId])
  @@index([ownerUserId, enabled])
  @@index([ownerUserId, enabled, deletedAt])
}

model WebhookEndpointSecretVersion {
  id                String    @id @default(cuid())
  webhookEndpointId String
  ownerUserId       String
  version           Int
  // This is the new forward-compatible encrypted secret store introduced in M10A.
  // New delivery records bind to a specific secret version through a composite FK.
  secretEncrypted   String    @db.Text
  // The hardcoded default is intentional: M9D already signs with HMAC-SHA256 using the v1 canonical format,
  // so backfilled and newly created version rows must agree on the same explicit scheme string.
  signatureScheme   String    @default("hmac_sha256_v1") @db.VarChar(64)
  isCurrent         Boolean   @default(false)
  createdAt         DateTime  @default(now()) @db.Timestamp(6)
  retiredAt         DateTime? @db.Timestamp(6)
  retainUntil       DateTime? @db.Timestamp(6)

  endpoint   WebhookEndpoint   @relation(fields: [webhookEndpointId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@unique([id, webhookEndpointId, ownerUserId])
  @@unique([webhookEndpointId, version])
  @@index([webhookEndpointId, createdAt])
  @@index([ownerUserId, retainUntil])
}

model WebhookEvent {
  id                     String   @id @default(cuid())
  ownerUserId            String
  eventType              String   @db.VarChar(120)
  schemaVersion          String   @db.VarChar(16)
  producerIdempotencyKey String?  @db.VarChar(190)
  resourceType           String   @db.VarChar(80)
  resourceId             String   @db.VarChar(120)
  occurredAt             DateTime @db.Timestamp(6)
  payload                Json
  dispatchEligible       Boolean
  auditOnly              Boolean
  sensitivity            String   @db.VarChar(32)
  createdAt              DateTime @default(now()) @db.Timestamp(6)

  deliveries WebhookDelivery[]

  @@unique([id, ownerUserId])
  @@index([ownerUserId, createdAt])
  @@index([eventType, occurredAt])
}

model WebhookDelivery {
  id                      String                @id @default(cuid())
  ownerUserId             String
  webhookEventId          String
  webhookEndpointId       String
  secretVersionId         String
  status                  WebhookDeliveryStatus @default(pending)
  attemptCount            Int                   @default(0)
  maxAttempts             Int                   @default(6)
  connectivityMaxAttempts Int                   @default(3)
  nextAttemptAt           DateTime?             @db.Timestamp(6)
  lastAttemptAt           DateTime?             @db.Timestamp(6)
  deliveredAt             DateTime?             @db.Timestamp(6)
  failedTerminalAt        DateTime?             @db.Timestamp(6)
  leaseToken              String?               @db.VarChar(120)
  leaseExpiresAt          DateTime?             @db.Timestamp(6)
  lastFailureDomain       WebhookFailureDomain?
  lastFailureCode         WebhookFailureCode    @default(none)
  idempotencyKey          String                @db.VarChar(190)
  targetUrlSnapshot       String                @db.VarChar(2048)
  signatureSchemeSnapshot String                @db.VarChar(64)
  secretVersionSnapshot   Int
  eventTypeSnapshot       String                @db.VarChar(120)
  approvedHeadersSnapshot Json?
  createdAt               DateTime              @default(now()) @db.Timestamp(6)
  updatedAt               DateTime              @updatedAt @db.Timestamp(6)

  event         WebhookEvent                 @relation(fields: [webhookEventId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  endpoint      WebhookEndpoint              @relation(fields: [webhookEndpointId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  secretVersion WebhookEndpointSecretVersion @relation(fields: [secretVersionId, webhookEndpointId, ownerUserId], references: [id, webhookEndpointId, ownerUserId], onDelete: Restrict)
  attempts      WebhookDeliveryAttempt[]

  @@unique([webhookEndpointId, webhookEventId])
  @@unique([ownerUserId, idempotencyKey])
  @@index([ownerUserId, status, nextAttemptAt])
  @@index([ownerUserId, failedTerminalAt])
  @@index([ownerUserId, leaseExpiresAt])
  @@index([webhookEndpointId, createdAt])
  @@index([secretVersionId])
}

model WebhookDeliveryAttempt {
  id                String                 @id @default(cuid())
  webhookDeliveryId String
  attemptNumber     Int
  startedAt         DateTime               @db.Timestamp(6)
  completedAt       DateTime?              @db.Timestamp(6)
  durationMs        Int?
  httpStatus        Int?
  outcome           WebhookAttemptOutcome?
  failureDomain     WebhookFailureDomain?
  failureCode       WebhookFailureCode?
  errorCode         String?                @db.VarChar(80)
  errorMessageSafe  String?                @db.VarChar(500)
  responseTruncated Boolean                @default(false)
  createdAt         DateTime               @default(now()) @db.Timestamp(6)

  delivery WebhookDelivery @relation(fields: [webhookDeliveryId], references: [id], onDelete: Restrict)

  @@unique([webhookDeliveryId, attemptNumber])
  @@index([webhookDeliveryId, attemptNumber])
  @@index([createdAt])
}

model BillingCustomer {
  id                 String          @id @default(cuid())
  ownerUserId        String
  provider           BillingProvider @default(stripe)
  providerCustomerId String          @db.VarChar(255)
  createdAt          DateTime        @default(now()) @db.Timestamp(6)
  updatedAt          DateTime        @updatedAt @db.Timestamp(6)

  owner         User                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subscriptions BillingSubscription[]

  @@unique([id, ownerUserId])
  @@unique([provider, providerCustomerId])
  @@unique([ownerUserId, provider])
  @@index([ownerUserId])
}

model BillingSubscription {
  id                        String                    @id @default(cuid())
  ownerUserId               String
  billingCustomerId         String
  provider                  BillingProvider           @default(stripe)
  providerSubscriptionId    String                    @db.VarChar(255)
  planKey                   String                    @db.VarChar(64)
  status                    BillingSubscriptionStatus
  currentPeriodStart        DateTime?                 @db.Timestamp(6)
  currentPeriodEnd          DateTime?                 @db.Timestamp(6)
  cancelAtPeriodEnd         Boolean                   @default(false)
  canceledAt                DateTime?                 @db.Timestamp(6)
  lastAppliedEventCreatedAt DateTime?                 @db.Timestamp(6)
  lastAppliedEventId        String?                   @db.VarChar(255)
  createdAt                 DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime                  @updatedAt @db.Timestamp(6)

  owner    User             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer BillingCustomer  @relation(fields: [billingCustomerId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  payments BillingPayment[]

  @@unique([id, ownerUserId])
  @@unique([provider, providerSubscriptionId])
  @@index([ownerUserId, status])
  @@index([billingCustomerId])
}

model BillingPayment {
  id                      String               @id @default(cuid())
  ownerUserId             String
  billingSubscriptionId   String?
  provider                BillingProvider      @default(stripe)
  providerInvoiceId       String               @db.VarChar(255)
  providerPaymentIntentId String?              @db.VarChar(255)
  amountCents             Int
  currency                String               @db.VarChar(3)
  status                  BillingPaymentStatus
  paidAt                  DateTime?            @db.Timestamp(6)
  failedAt                DateTime?            @db.Timestamp(6)
  failureCode             String?              @db.VarChar(80)
  createdAt               DateTime             @default(now()) @db.Timestamp(6)
  updatedAt               DateTime             @updatedAt @db.Timestamp(6)

  owner        User                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subscription BillingSubscription? @relation(fields: [billingSubscriptionId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, providerInvoiceId])
  @@index([ownerUserId, createdAt])
  @@index([billingSubscriptionId])
}

model BillingWebhookEvent {
  id                     String                    @id @default(cuid())
  provider               BillingProvider           @default(stripe)
  providerEventId        String                    @db.VarChar(255)
  eventType              String                    @db.VarChar(120)
  apiVersion             String?                   @db.VarChar(32)
  status                 BillingWebhookEventStatus @default(received)
  ownerUserId            String?
  providerCustomerId     String?                   @db.VarChar(255)
  providerSubscriptionId String?                   @db.VarChar(255)
  providerInvoiceId      String?                   @db.VarChar(255)
  eventCreatedAt         DateTime                  @db.Timestamp(6)
  receivedAt             DateTime                  @default(now()) @db.Timestamp(6)
  lastAttemptedAt        DateTime?                 @db.Timestamp(6)
  processedAt            DateTime?                 @db.Timestamp(6)
  attemptCount           Int                       @default(0)
  lastFailureCode        String?                   @db.VarChar(80)
  createdAt              DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt              DateTime                  @updatedAt @db.Timestamp(6)

  @@unique([provider, providerEventId])
  @@index([ownerUserId, receivedAt])
  @@index([status, receivedAt])
  @@index([providerSubscriptionId])
}
