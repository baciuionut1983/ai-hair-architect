// AI Usage & Cost Metering Phase 1: the fixed, small set of billable AI
// operation shapes this platform's provider cost genuinely varies by
// (token-metered text/vision calls vs. duration/count-metered audio,
// image, or video). A real Postgres enum, not an app-level string, because
// this vocabulary is expected to change rarely -- matching this schema's
// existing convention for closed operation vocabularies (WebhookFailureDomain,
// BillingSubscriptionStatus, etc.), unlike `feature` below, which is
// expected to grow every time a new AI-touching capability ships.
// IMAGE_GENERATION and VIDEO_GENERATION are not produced by any code path
// yet (AI Proposed Look Phase 2 and beyond) -- included now, per the AI
// Usage & Cost Metering Phase 1 task's explicit future-readiness
// requirement, so that work never needs a schema migration just to start
// recording usage.
enum AiUsageModality {
  TEXT_GENERATION
  IMAGE_ANALYSIS
  IMAGE_GENERATION
  VIDEO_GENERATION
  STT
  TTS
}

enum AiUsageOutcome {
  SUCCEEDED
  FAILED
}

// Mirrors Step 2's explicit accounting requirement: a cost figure must
// never be presented as more certain than it actually is. EXACT: the
// provider itself returned a cost (no provider used by this app does
// today). CALCULATED: a real usage quantity (e.g. real token counts) was
// multiplied by an authoritative, versioned price. ESTIMATED: a cost was
// derived without a real usage quantity (e.g. from a rough duration/size
// proxy). UNAVAILABLE: no cost could be produced at all -- the honest
// default, never silently coerced to 0.
enum AiUsageCostBasis {
  EXACT
  CALCULATED
  ESTIMATED
  UNAVAILABLE
}

// AI Usage & Cost Metering Phase 1: one row per real provider call
// (never per logical retry group -- see attemptNumber/correlationId),
// covering every AI-touching feature (Consult AI, image analysis, STT,
// TTS today; image/video generation later) uniformly. This is an
// accounting/observability ledger, not a second conversation database --
// see Step 5's data-minimization requirement -- so it never stores a
// prompt, a reply, a transcript, audio, or a photo; correlationId is a
// soft pointer (no FK, mirroring AuditLog.resourceId's existing
// precedent) to the feature's own authoritative record
// (ConsultationMessage/ImageAnalysis/VoiceTranscript id) when one exists.
//
// `usage` is a single Json column, not one nullable column per possible
// billable quantity (input/output/cached/reasoning tokens, audio
// seconds, characters, image/video counts) -- deliberately mirroring
// this schema's own established precedent for the exact same kind of
// variable-shaped-by-type data (Analysis.technicalCutPlan/colorPlan/
// treatmentPlan, AnalysisCorrection.previousValue/newValue), rather than
// the "giant nullable table" the task's own Step 2 explicitly warns
// against. Shape: AiUsageQuantities in ai-usage-contracts.ts.
//
// clientId/analysisId are deliberately plain, unconstrained strings, not
// FKs (unlike VoiceTranscript's clientId) -- this ledger must never block
// or complicate an unrelated future Client/Analysis lifecycle operation
// (e.g. a right-to-erasure hard delete) just because an old cost record
// still names it, the same reasoning AuditLog.resourceId already applies
// in this schema. workspaceId is reserved for a real multi-stylist
// workspace/salon concept that does not exist yet in this product (see
// AnalysisCorrection's own comment on WorkspaceRecord being legacy/
// in-memory only) -- always null today, kept so aggregation-by-salon
// (Step 7) does not need a second migration the day a real Workspace
// model is introduced.
model AiUsageEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @db.Timestamp(6)

  ownerUserId String
  workspaceId String?
  clientId    String?
  analysisId  String?

  feature        String          @db.VarChar(64)
  modality       AiUsageModality
  correlationId  String          @db.VarChar(64)
  attemptNumber  Int             @default(1)
  // Deterministically derived from (correlationId, attemptNumber) by the
  // one recording entry point (recordAiUsageEvent) when a caller does not
  // supply its own -- see Step 4's duplicate-submission requirement. A
  // unique-constraint violation on write is treated as "already recorded",
  // never as an error the caller sees.
  idempotencyKey String          @db.VarChar(160)

  provider          String  @db.VarChar(32)
  model             String  @db.VarChar(64)
  providerRequestId String? @db.VarChar(128)

  usage          Json    @default("{}")
  // False whenever the provider response never exposed real usage
  // metadata (or the call failed before any response existed) -- Step 6's
  // explicit "mark unavailable, never fabricate" requirement made
  // directly queryable, not just inferable from an empty `usage` object.
  usageAvailable Boolean @default(false)

  estimatedCostMicros BigInt?
  currency            String?          @db.VarChar(3)
  pricingVersion      String?          @db.VarChar(32)
  costBasis           AiUsageCostBasis @default(UNAVAILABLE)

  outcome       AiUsageOutcome
  errorCategory String?        @db.VarChar(64)
  latencyMs     Int?

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([idempotencyKey])
  @@index([ownerUserId, createdAt])
  @@index([feature, createdAt])
  @@index([provider, model, createdAt])
  @@index([createdAt])
  @@index([correlationId])
}

// AI Proposed Look (Phase 2): the durable, frozen record of one
// deterministic-engine proposal for a single Client in a single vertical,
// moving through the lifecycle DRAFT | CONFIRMED | REJECTED | SUPERSEDED.
// Written once at generation time; thereafter only transitioned by the
// repository layer (Stage 2, authorized separately). evidenceSnapshot,
// payload, edits, consideredMemory and promotedConsultationSources are all
// frozen provenance -- never live-recomputed from the (possibly
// since-changed) source Analysis or ProfessionalMemory rows.
//
// AUTHORITATIVE INVARIANT -- deliberately NOT expressed in this model block
// because the Prisma schema language cannot represent it: at most one row
// may have status = 'CONFIRMED' for a given (ownerUserId, clientId,
// vertical). It is enforced by a hand-authored PARTIAL UNIQUE INDEX in the
// migration SQL (migrations/20260827_analysis_proposal/migration.sql):
//
//   CREATE UNIQUE INDEX "AnalysisProposal_one_confirmed_per_owner_client_vertical"
//     ON "AnalysisProposal" ("ownerUserId", "clientId", "vertical")
//     WHERE "status" = 'CONFIRMED';
//
// Prisma has no native partial/filtered unique index, so a future
// `prisma migrate dev` diff will NOT see this index and MUST NOT be told to
// "fix" or drop it -- this is a known, documented Prisma limitation, not
// drift. The same pattern is already used in this schema for
// WebhookEndpointSecretVersion ("one current per endpoint") and WebhookEvent
// (producer-idempotency), both partial unique indexes that live only in
// migration SQL (see 20260720_m10a_delivery_contracts).
model AnalysisProposal {
  id          String @id @default(uuid())
  ownerUserId String
  clientId    String

  // Plain string, NOT a Postgres enum -- deliberately mirrors how
  // Analysis.phase is a plain string enforced only by application code
  // (ANALYSIS_PHASES). Chosen specifically so that adding a new vertical
  // later never requires a schema migration. Stage 2 validates the value.
  vertical String

  // Plain string, NOT a Postgres enum -- same reasoning as `vertical` above
  // and Analysis.phase, to avoid a migration if the lifecycle changes.
  // Application-validated (Stage 2) to exactly one of:
  // DRAFT | CONFIRMED | REJECTED | SUPERSEDED.
  status String

  analysisId String

  // The source Analysis.updatedAt value at the moment this proposal was
  // created, frozen -- lets a later reader detect that the underlying
  // Analysis has since changed without diffing full content.
  analysisSnapshotAt DateTime @db.Timestamp(6)

  // Nullable, NO enforced FK (soft pointers) -- populated from the source
  // Analysis's own linked asset / image-analysis when available. Follows the
  // established soft-ID-pointer precedent in this schema
  // (AiUsageEvent.clientId / analysisId, AuditLog.resourceId): this frozen
  // provenance must never block or complicate an unrelated ImageAsset /
  // ImageAnalysis lifecycle operation just because an old proposal names it.
  sourceImageAssetId    String?
  sourceImageAnalysisId String?

  // The deterministic engine's own version string at generation time -- the
  // cutting engine's TechnicalCutPlan.version value verbatim
  // (TECHNICAL_PLAN_VERSION in cutting-plan-engine.ts, e.g. "1.0.0-m8"), not
  // a new versioning scheme.
  engineVersion String

  // Frozen INPUT evidence: the objective / category-A fields actually read
  // from the source Analysis at creation time (contraindications, density,
  // condition, structural-limitation-relevant fields). Distinct from the
  // engine's OUTPUT (`payload`).
  evidenceSnapshot Json

  // Frozen engine-generated baseline / OUTPUT (the deterministic plan
  // content) as of confirmation time -- the durable "what the proposal
  // actually says", never live-recomputed from the (possibly since-changed)
  // Analysis row.
  payload Json

  // Nullable. Populated only if the professional changed something in the
  // DRAFT before confirming. Array; each entry mirrors AnalysisCorrection's
  // existing vocabulary: { field, previousValue, newValue, source, reason }
  // (reason optional). Provenance only, NOT a lifecycle state -- there is no
  // "edited" status; "was this proposal edited?" is answered by whether this
  // array is non-empty.
  edits Json?

  // Nullable array. For each ProfessionalMemory row actually used when
  // resolving this proposal's aesthetic / category-B fields, both the id AND
  // a minimal content snapshot at that time:
  // { memoryId, content, kind, scope, confidence, snapshotAt }. IDs alone
  // are insufficient -- the historical explanation must stay valid even if
  // that memory is later revoked or edited.
  consideredMemory Json?

  // Nullable soft pointer (NO enforced FK) to the single most relevant
  // promoted ConsultationMessage, if one exists. This schema has no existing
  // relation to ConsultationMessage to mirror, and AiUsageEvent already
  // treats ConsultationMessage ids as soft pointers; handled here the same
  // way as sourceImageAssetId above.
  primaryConsultationMessageId String?

  // Nullable array. Frozen provenance for 0..N explicitly-promoted
  // consultation insights (not only the single primary one):
  // { consultationMessageId, snapshotContent, promotedAt }[]. Only ever
  // contains entries a human explicitly chose to promote -- general,
  // un-promoted chat content must never appear here.
  promotedConsultationSources Json?

  // Nullable pointer to the proposal that superseded this one. Plain nullable
  // column, NOT an enforced self-relation FK: this schema has no existing
  // self-referencing relation to mirror, Prisma self-relations with the
  // tenant-composite key shape used here are awkward, and this is frozen
  // provenance consistent with the other soft pointers on this model. Stage 2
  // repository code guarantees it references a sibling proposal in the same
  // (ownerUserId, clientId, vertical).
  supersededByProposalId String?

  // Set once at confirmation / rejection, never edited afterward (enforced at
  // the repository layer in Stage 2). confirmedByUserId is a plain column
  // with NO FK, mirroring ProfessionalMemory.createdByUserId.
  confirmedByUserId String?
  confirmedAt       DateTime? @db.Timestamp(6)
  rejectedAt        DateTime? @db.Timestamp(6)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  owner               User                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client              Client               @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  analysis            Analysis             @relation(fields: [analysisId, ownerUserId, clientId], references: [id, ownerUserId, clientId], onDelete: Restrict, onUpdate: Cascade)
  // Technical Visual Map, Stage 1. Virtual back-relation only -- produces no
  // column or constraint here; the FK lives on "TechnicalVisualMap".
  technicalVisualMaps TechnicalVisualMap[]

  @@unique([id, ownerUserId, clientId])
  @@index([clientId, ownerUserId, createdAt, id])
  @@index([analysisId, ownerUserId, clientId])
  @@index([ownerUserId, clientId, vertical])
}

// Technical Visual Map, Stage 1 -- see prisma/migrations/20260829_technical_visual_map
// for the hand-authored partial unique index this model alone cannot express.
//
// The `@@unique([id, ownerUserId, clientId])` added to AnalysisProposal above
// (Decision Lock finding: AnalysisProposal previously had no composite unique
// beyond its own `id`, unlike Analysis's existing `@@unique([id, ownerUserId,
// clientId])`) is what makes the `proposal` relation below a real,
// database-enforced composite FK rather than a bare, untrusted
// analysisProposalId -- exactly the same integrity pattern AnalysisProposal
// itself already relies on for its own `analysis` relation. Verified
// additive and safe before this change: AnalysisProposal had 0 rows at
// migration time, and `id` alone is already globally unique, so no existing
// or possible row can ever violate this 3-column composite.
model TechnicalVisualMap {
  id          String @id @default(uuid())
  ownerUserId String
  clientId    String

  // Composite-FK'd to AnalysisProposal[id, ownerUserId, clientId] below --
  // never trusted as a bare, unscoped id. See AnalysisProposal's own
  // `analysisId` for the identical precedent.
  analysisProposalId String

  // Plain string, NOT a Postgres enum -- mirrors AnalysisProposal.vertical
  // and Analysis.phase exactly, for the same reason: a new vertical must
  // never require a migration. Stage 1 contains no vertical-specific logic;
  // application validation arrives in Stage 2. Only "cutting" is used at
  // runtime today.
  vertical String

  // Plain string, NOT a Postgres enum -- same reasoning as `vertical`.
  // Application-validated (Stage 2) to exactly one of:
  // DRAFT | CONFIRMED | SUPERSEDED. Deliberately no REJECTED state -- see
  // the Decision Lock: a map is a derived artifact of an already-CONFIRMED
  // proposal, not an independently-evaluated option with its own accept/
  // decline decision.
  status String

  // Identifies map revisions within the locked authority scope
  // (ownerUserId, clientId, analysisProposalId, vertical) -- one proposal
  // may produce multiple map versions over time (better generator logic, a
  // professional starting over). Historical rows are never overwritten.
  mapVersion Int

  // The frozen PAYLOAD SHAPE's own version, distinct from mapVersion (a
  // revision counter) -- same "freeze what was actually used, even if the
  // shape evolves later" reasoning as generatorVersion below and
  // AnalysisProposal.engineVersion.
  schemaVersion String

  // Frozen JSON. Stage 1 deliberately stores no Prisma-level structure for
  // this beyond "it is JSON" -- the locked semantic shape (six anatomical
  // zones, typed per-zone intent with explicit source attribution, zone
  // relationships, preserve/safety constraints) is Stage 2's application-level
  // validator/assembler work, not a Stage 1 schema concern. Never mutated in
  // place once written; a later revision is a new row (new mapVersion).
  payload Json

  // Nullable soft pointers (NO enforced FK) -- same established precedent as
  // AnalysisProposal.sourceImageAssetId/sourceImageAnalysisId. V1 is
  // semantic-only (no coordinates, no dimensions, no crop geometry -- all
  // explicitly deferred to a later image-bound spatial prerequisite per the
  // Decision Lock); these exist now purely so the traceability chain
  // (Analysis -> AnalysisProposal -> TechnicalVisualMap -> future Photo/
  // Video) already reaches one link further, at zero cost, without a second
  // migration later just to add fields that already have a proven shape.
  sourceImageAssetId    String?
  sourceImageAnalysisId String?

  // The deterministic assembler's own frozen version string (Stage 2) --
  // same discipline as AnalysisProposal.engineVersion. If mapping logic
  // improves later, existing rows keep their original generatorVersion,
  // never silently upgraded.
  generatorVersion String

  // Nullable array, frozen-baseline + additive-adjustment architecture --
  // mirrors AnalysisProposal.edits exactly: {field, previousValue, newValue,
  // source, reason?}. A professional's adjustment is layered on top here; it
  // never mutates `payload`, the frozen generator output. No adjustment
  // BEHAVIOR is implemented in Stage 1 -- this column exists so Stage 2 has
  // somewhere to write additively from day one.
  professionalAdjustments Json?

  // Nullable pointer to the map that superseded this one -- mirrors
  // AnalysisProposal.supersededByProposalId. Plain nullable column, NOT an
  // enforced self-relation FK: same reasoning as AnalysisProposal's own
  // choice (no existing self-referencing relation to mirror in this schema,
  // and a composite-key self-relation here would add real complexity for a
  // pointer Stage 2's repository layer already guarantees references a
  // sibling row in the same (ownerUserId, clientId, analysisProposalId,
  // vertical) scope -- enforcing that in the schema itself was evaluated and
  // judged not worth the added complexity, the same tradeoff already made
  // for supersededByProposalId). No supersession is performed in Stage 1;
  // Stage 2 repository logic owns that behavior.
  supersededByMapId String?

  // Set once, on confirm -- never edited afterward (enforced at the
  // repository layer in Stage 2, mirroring confirmedAt/rejectedAt on
  // AnalysisProposal).
  confirmedAt  DateTime? @db.Timestamp(6)
  supersededAt DateTime? @db.Timestamp(6)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  owner    User             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client   Client           @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  proposal AnalysisProposal @relation(fields: [analysisProposalId, ownerUserId, clientId], references: [id, ownerUserId, clientId], onDelete: Restrict, onUpdate: Cascade)

  // Technical Visual Map, Stage 5A. Virtual back-relation only -- produces no
  // column or constraint on "TechnicalVisualMap"; the composite FK
  // (technicalVisualMapId, ownerUserId, clientId) lives on
  // "TechnicalVisualMapSpatialBinding" and targets the new
  // @@unique([id, ownerUserId, clientId]) added below -- the exact same
  // prerequisite-fix pattern this migration's own predecessor (Stage 1)
  // already applied to AnalysisProposal before this model could reference
  // *it* compositely.
  spatialBindings TechnicalVisualMapSpatialBinding[]

  @@unique([analysisProposalId, ownerUserId, clientId, vertical, mapVersion])
  // Stage 5A prerequisite: TechnicalVisualMapSpatialBinding needs a real
  // composite FK to this exact map (Decision Lock 16/17) -- structurally
  // safe to add regardless of existing data, since `id` is already this
  // model's own primary key (globally unique on its own); this only ever
  // adds a redundant-but-harmless second uniqueness guarantee over columns
  // that already co-occur uniquely per row. Verified against the real
  // database before migration: 0 existing TechnicalVisualMap rows.
  @@unique([id, ownerUserId, clientId])
  @@index([clientId, ownerUserId, createdAt, id])
  @@index([analysisProposalId, ownerUserId, clientId])
  @@index([ownerUserId, clientId, analysisProposalId, vertical])
}

// Technical Visual Map, Stage 5A -- schema/migration only (see
// prisma/migrations/<this migration>/migration.sql for the hand-authored
// partial unique index this model alone cannot express). Locked at the
// Stage 5 Decision Lock: geometry for ONE exact CONFIRMED TechnicalVisualMap
// + ONE exact source image + ONE professional-declared view. It is NOT
// another TechnicalVisualMap, NOT embedded into TechnicalVisualMap.payload,
// and NOT a Photo/Video artifact -- a separate child with its own
// independent lifecycle/versioning, so a geometry change never forces a new
// semantic mapVersion or reopens semantic confirmation. No validators,
// assembler, repository, or API exist yet -- Stage 5B's job.
model TechnicalVisualMapSpatialBinding {
  id          String @id @default(uuid())
  ownerUserId String
  clientId    String

  // Composite-FK'd to TechnicalVisualMap[id, ownerUserId, clientId] below --
  // never trusted as a bare, unscoped id (Decision Lock 8/16/17: the parent
  // relationship is strongly bound, unlike the image pointer below).
  technicalVisualMapId String

  // Validated pointer, deliberately NOT a database FK -- Decision Lock 10/16:
  // the real integrity guarantee for pixel-content correctness comes from
  // the frozen snapshot fields below (copied at creation time, Stage 5B),
  // not from a live relation to a row whose bytes are never rewritten in
  // place anyway. Mirrors the exact existing
  // AnalysisProposal/TechnicalVisualMap.sourceImageAssetId precedent.
  // Required (not nullable) -- unlike the semantic map's own optional
  // pointer, a spatial binding is by definition bound to a real image.
  sourceImageAssetId String

  // Nullable soft pointer, provenance-only -- same precedent as
  // TechnicalVisualMap.sourceImageAnalysisId. Deliberately excluded from the
  // authority/uniqueness scope below (Decision Lock 12): which AI analysis
  // record, if any, touched this image has no bearing on which geometry is
  // current for it.
  sourceImageAnalysisId String?

  // Plain string, NOT a Postgres enum -- same reasoning as every other
  // lifecycle/vocabulary string in this domain (vertical, status, zone,
  // viewLabel): a new value must never require a migration. Stage 5B will
  // application-validate this to a closed set (front | left_profile |
  // right_profile | back | other) -- professional-declared metadata only;
  // nothing in this pipeline can verify a photo actually shows what its
  // label claims (Decision Lock 10).
  viewLabel String

  // Plain string, NOT a Postgres enum. Application-validated (Stage 5B) to
  // exactly one of: DRAFT | CONFIRMED | SUPERSEDED. Deliberately no REJECTED
  // state -- same reasoning as TechnicalVisualMap's own lifecycle: a derived
  // artifact of an already-confirmed parent, not an independently-evaluated
  // option with its own accept/decline decision.
  status String

  // Identifies spatial revisions within the locked authority scope
  // (ownerUserId, clientId, technicalVisualMapId, sourceImageAssetId,
  // viewLabel) -- an INDEPENDENT counter from TechnicalVisualMap.mapVersion
  // (Decision Lock 13/14): geometry can be revised without the haircut
  // intent changing at all, and vice versa. Historical rows are never
  // overwritten.
  spatialVersion Int

  // The frozen PAYLOAD SHAPE's own version, distinct from spatialVersion (a
  // revision counter) -- same "freeze what was actually used, even if the
  // shape evolves later" reasoning as TechnicalVisualMap.schemaVersion.
  geometrySchemaVersion String

  // Frozen JSON. Stage 5A deliberately stores no Prisma-level structure for
  // this beyond "it is JSON" -- the locked semantic shape (six zone anchors
  // with not_placed/placed/not_visible state, normalized 0..1 coordinates,
  // and one perimeter boundary polyline with the same state model) is Stage
  // 5B's application-level validator/assembler work, not a schema concern.
  // No x/y columns per zone -- decomposing normalized geometry into SQL
  // columns would fight the same "shape can evolve, rows shouldn't need a
  // migration for it" reasoning TechnicalVisualMap.payload already settled.
  payload Json

  // Frozen source-image snapshot (Decision Lock 15/16) -- copied from the
  // real ImageAsset row AT BINDING-CREATION TIME (Stage 5B), never derived
  // dynamically and never re-read live thereafter. This is what makes the
  // validated pointer above safe without a database FK: even if the live
  // ImageAsset row's own width/height/orientation were ever wrong or
  // unavailable, this binding's own frozen copy is authoritative for
  // interpreting its own payload's coordinates.
  //
  // frozenWidth/frozenHeight/frozenOrientation are REQUIRED (never null) on
  // the binding itself -- a spatial binding cannot exist without them, which
  // is exactly why ImageAsset.width/height being nullable (Stage 5A, above)
  // does not weaken this guarantee: an asset with null dimensions simply
  // cannot have a spatial binding created for it yet (fails safely at the
  // Stage 5B repository layer, not modeled here as a schema-level
  // possibility).
  frozenWidth       Int
  frozenHeight      Int
  frozenOrientation Int

  // Nullable -- ImageAsset.contentSha256 is confirmed (Decision Lock 4) to
  // exist ONLY for S3-backed uploads, never local-backed ones, so this can
  // never be assumed universally present. When available it is the
  // strongest immutability anchor; when absent, the required frozen
  // dimensions above remain the safe floor.
  frozenContentSha256 String? @db.Char(64)

  // Nullable, S3-only extra defense-in-depth -- mirrors
  // ImageAsset.storageVersionId's own type exactly (same VarChar length),
  // frozen at creation time rather than re-resolved from a possibly-rotated
  // live pointer.
  frozenStorageVersionId String? @db.VarChar(1024)

  // Nullable pointer to the spatial binding that superseded this one --
  // mirrors TechnicalVisualMap.supersededByMapId exactly, including its own
  // reasoning: a plain nullable column, NOT an enforced self-relation FK.
  // Evaluated per Decision Lock 14 and rejected for the same reason the
  // precedent already gives -- no existing self-referencing relation to
  // mirror in this schema, and a composite-key self-relation would add real
  // complexity for a pointer Stage 5B's repository layer already guarantees
  // references a sibling row in the exact same (ownerUserId, clientId,
  // technicalVisualMapId, sourceImageAssetId, viewLabel) scope. No
  // supersession behavior is performed in Stage 5A; Stage 5B repository
  // logic owns that behavior.
  supersededBySpatialBindingId String?

  // Set once, on confirm -- never edited afterward (enforced at the
  // repository layer in Stage 5B, mirroring confirmedAt/supersededAt on
  // TechnicalVisualMap).
  confirmedAt  DateTime? @db.Timestamp(6)
  supersededAt DateTime? @db.Timestamp(6)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  owner              User               @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client             Client             @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  technicalVisualMap TechnicalVisualMap @relation(fields: [technicalVisualMapId, ownerUserId, clientId], references: [id, ownerUserId, clientId], onDelete: Restrict, onUpdate: Cascade)

  // Version uniqueness within the locked authority scope (Decision Lock 12).
  @@unique([technicalVisualMapId, ownerUserId, clientId, sourceImageAssetId, viewLabel, spatialVersion])
  @@index([clientId, ownerUserId, technicalVisualMapId])
  @@index([technicalVisualMapId, ownerUserId, clientId, sourceImageAssetId, viewLabel, spatialVersion])
  @@index([ownerUserId, clientId, technicalVisualMapId, sourceImageAssetId, viewLabel, status])
}

// Real AI Photo Preview, Stage 1 -- the durable, auditable generation
// artifact. This is NOT a professional authority object (unlike
// AnalysisProposal/TechnicalVisualMap/TechnicalVisualMapSpatialBinding) --
// it is a derived, disposable generation job/artifact, hence a distinct
// REQUESTED | PROCESSING | COMPLETED | FAILED lifecycle rather than a
// reused DRAFT | CONFIRMED | SUPERSEDED (task §5). No CANCELLED state is
// added now: nothing in this codebase runs genuine cancellable worker
// infrastructure yet (task §21/§22), so a CANCELLED value would be dead,
// unreachable vocabulary.
//
// analysisProposalId / technicalVisualMapId (+ their own frozen version
// anchors) and sourceImageAssetId / sourceImageAnalysisId are all
// deliberately VALIDATED POINTERS, NOT enforced database foreign keys --
// same established precedent as every other sourceImageAssetId in this
// schema. Two reasons, not one: (1) TechnicalVisualMapSpatialBinding itself
// has no `@@unique([id, ownerUserId, clientId])` today, so a real composite
// FK to it would require ALSO migrating that already-shipped Stage 5C
// table -- explicitly out of scope for this stage; (2) the real integrity
// guarantee this row needs is "what was true at generation-request time,
// forever", which frozen snapshot fields provide directly, exactly the same
// reasoning TechnicalVisualMapSpatialBinding's own frozenWidth/frozenHeight
// doc comment already gives for not leaning on a live relation for that
// purpose. spatialBindingId is the one id this row's own lifecycle actually
// depends on operationally (it is what request creation re-validates), but
// even it stays a validated pointer here for the same reason.
model PhotoPreviewGeneration {
  id          String @id @default(uuid())
  ownerUserId String
  clientId    String

  // Frozen pointer + version anchor. AnalysisProposal has no revision
  // counter of its own (a replacement is a whole new row, never a revision
  // in place) -- confirmedAt is therefore the correct "was this the exact
  // confirmed proposal at generation-request time" anchor, mirroring how
  // every other frozen-version field in this schema anchors to whatever
  // that specific parent actually versions by.
  analysisProposalId          String
  analysisProposalConfirmedAt DateTime @db.Timestamp(6)

  technicalVisualMapId String
  mapVersion           Int

  spatialBindingId String
  spatialVersion   Int

  // Required (not nullable) -- a generation request is by definition bound
  // to a real image, same reasoning as
  // TechnicalVisualMapSpatialBinding.sourceImageAssetId.
  sourceImageAssetId    String
  sourceImageAnalysisId String?

  viewLabel String

  // Frozen source-image identity snapshot -- same precedent as
  // TechnicalVisualMapSpatialBinding.frozenWidth/frozenHeight/
  // frozenOrientation/frozenContentSha256/frozenStorageVersionId, copied at
  // creation time, never re-read live afterward.
  frozenSourceWidth            Int
  frozenSourceHeight           Int
  frozenSourceOrientation      Int
  frozenSourceContentSha256    String? @db.Char(64)
  frozenSourceStorageVersionId String? @db.VarChar(1024)

  // Plain strings, NOT Postgres enums -- same reasoning as every other
  // provider/vertical/status field in this schema: a new candidate model or
  // a future non-Gemini provider must never require a migration.
  // Application-validated against a fixed allowlist
  // (photo-preview-provider-config.ts) before this row is ever created.
  provider String
  model    String

  generationSchemaVersion String

  // The frozen SealedPhotoPreviewRequest (photo-preview-contracts.ts) --
  // the one and only authoritative generation intent. Never the browser's
  // own prompt; never provider-specific instruction prose (task §3/§12).
  sealedRequest Json

  // DB-level idempotency backstop (task §18/§20 -- "no application-only
  // race protection"). Deterministically derived from the exact frozen
  // scope + provider/model + variationIndex
  // (computePhotoPreviewRequestFingerprint). The @@unique below is what
  // makes two concurrent identical "Generate" submissions resolve to the
  // SAME row rather than two billable jobs -- mirrors AiUsageEvent's own
  // idempotencyKey precedent exactly, including its own documented
  // "a unique-constraint violation on write means already recorded, never
  // an error the caller sees" handling.
  requestFingerprint String @db.VarChar(64)

  // 0 for an ordinary "Generate" action; explicitly incremented only by a
  // deliberate "Generate another variation" action (task §18/§29) -- never
  // inferred, never auto-incremented by a retry.
  variationIndex Int @default(0)

  // REQUESTED -> PROCESSING -> COMPLETED | FAILED. Plain string, not an
  // enum -- see this model's own header comment for why CANCELLED is
  // deliberately absent for now.
  status String

  providerRequestId     String?
  generatedImageAssetId String?

  // Safe, closed-vocabulary failure codes only (task §31) -- never a raw
  // provider stack trace or secret. errorMetadata is additional safe,
  // structured context (e.g. a provider's own public error code), never
  // free-form provider response dumps.
  errorCode     String?
  errorMetadata Json?

  requestedAt DateTime  @default(now()) @db.Timestamp(6)
  startedAt   DateTime? @db.Timestamp(6)
  completedAt DateTime? @db.Timestamp(6)
  failedAt    DateTime? @db.Timestamp(6)

  // Real AI Photo Preview, Stage 2 -- how many times a real provider
  // attempt has been claimed for THIS ONE generation row (never reset).
  // Distinct from variationIndex, which distinguishes separate generation
  // ARTIFACTS -- this counts retries of the SAME artifact's own provider
  // call, bounded by MAX_PROVIDER_ATTEMPTS_PER_GENERATION
  // (photo-preview-execution-repository.ts), mirroring the exact existing
  // attemptCount precedent used elsewhere in this schema (e.g.
  // WebhookDelivery, BackupRestoreRun). The full per-attempt audit trail
  // (provider/model/usage/cost per attempt) lives in AiUsageEvent, keyed by
  // correlationId = this row's own id -- a separate attempt-log table would
  // duplicate what AiUsageEvent already records.
  attemptCount Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  owner  User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client Client @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([requestFingerprint])
  @@index([ownerUserId, clientId])
  @@index([spatialBindingId, ownerUserId, clientId])
  @@index([status])
}

// Real AI Video Demonstration, Stage 1 -- the durable video output an
// otherwise-durable Photo Preview generation's bytes get persisted as.
// Deliberately a SEPARATE table from ImageAsset (Video Stage 0 Decision
// Lock, section 7/H): video has genuinely different metadata (duration,
// no width/height-as-spatial-truth) and none of ImageAsset's image-specific
// processing (EXIF, sharp normalization) applies -- generalizing ImageAsset
// would have forced irrelevant fields onto every future image row. Mirrors
// ImageAsset's own storage-column shape exactly (same object-storage.ts
// abstraction, same backend/key/etag/version fields) so the existing S3
// write/read primitives are reused verbatim, never reimplemented.
model VideoAsset {
  id          String @id @default(uuid())
  ownerUserId String
  clientId    String

  mimeType  String
  sizeBytes Int

  durationSeconds Float?

  storagePath        String
  storageBackend     String?  @db.VarChar(16)
  storageBucketAlias String?  @db.VarChar(64)
  storageKey         String?  @db.VarChar(512)
  storageVersionId   String?  @db.VarChar(1024)
  storageEtag        String?  @db.VarChar(256)
  contentSha256      String?  @db.Char(64)

  createdAt DateTime @default(now()) @db.Timestamp(6)

  owner  User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client Client @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)

  @@index([ownerUserId, clientId])
}

// Real AI Video Demonstration, Stage 1 -- the durable, auditable generation
// job. Mirrors PhotoPreviewGeneration's own conventions deliberately
// (Video Stage 0 Decision Lock): validated pointers (not FKs) to its
// authority chain, a frozen sealedRequest, a DB-level idempotency
// fingerprint, owner/client scoping identical to every other domain table.
//
// Two real differences from PhotoPreviewGeneration, both required by the
// Decision Lock:
//
// 1. photoPreviewGenerationId is the ONLY authority Video ever consults --
//    never AnalysisProposal/TechnicalVisualMap/TechnicalVisualMapSpatialBinding
//    directly. The analysisProposalId/analysisProposalConfirmedAt/
//    technicalVisualMapId/mapVersion/spatialBindingId/spatialVersion fields
//    below are a SNAPSHOT COPIED FROM the source PhotoPreviewGeneration row
//    at video-request-creation time (never re-derived from the live chain),
//    so a video request permanently carries its own historical proof of
//    "what authorized this" even if the source proposal/map/binding are
//    later superseded (Decision Lock section 5 -- "historical provenance
//    over current-state guessing"). PhotoPreviewGeneration itself has no
//    @@unique([id, ownerUserId, clientId]) today (same reason its own
//    parents are validated pointers, not FKs), so photoPreviewGenerationId
//    cannot be a real composite FK either -- same precedent, not a new one.
//
// 2. status has a real SUBMITTED/PROCESSING distinction Photo Preview never
//    needed (Photo Preview's provider call is synchronous -- claim IS the
//    entire attempt). Video generation is a genuinely asynchronous
//    provider-side job (Veo: 11s-6min): REQUESTED -> PROCESSING covers both
//    "claimed, about to submit" and "submitted, provider is working" --
//    the load-bearing distinction is NOT a separate status value but the
//    providerOperationId field itself: once it is non-null, recovery must
//    ALWAYS poll that exact operation, never submit a new one. See
//    video-generation-execution-service.ts's own header comment for the
//    full state-machine reasoning.
model VideoDemonstrationGeneration {
  id          String @id @default(uuid())
  ownerUserId String
  clientId    String

  // The ONLY authority Video consults (Decision Lock section F/G).
  // Validated pointer, not FK -- see model comment above.
  photoPreviewGenerationId String

  // Frozen authority-chain snapshot, copied from the source
  // PhotoPreviewGeneration row at THIS row's creation time -- permanent,
  // self-contained proof of "what was true then". Never re-read live from
  // AnalysisProposal/TechnicalVisualMap/TechnicalVisualMapSpatialBinding
  // afterward.
  analysisProposalId          String
  analysisProposalConfirmedAt DateTime @db.Timestamp(6)
  technicalVisualMapId        String
  mapVersion                  Int
  spatialBindingId            String
  spatialVersion               Int

  // The Photo Preview's own generated image -- the actual image-to-video
  // starting frame (Decision Lock section E: Video animates an
  // already-confirmed RESULT image, never the raw "before" photo).
  // Validated pointer, not FK -- ImageAsset rows are never rewritten in
  // place; the frozen hash below is the real integrity guarantee, same
  // precedent as every other frozen-source-identity field in this schema.
  sourceGeneratedImageAssetId String
  frozenSourceContentSha256   String? @db.Char(64)

  // Plain strings, not Postgres enums -- same reasoning as every other
  // provider/model field in this schema (task §8: never hardcoded, always
  // operator-configurable without a migration).
  provider String
  model    String

  generationSchemaVersion String

  // The frozen VideoDemonstrationSealedRequest (video-generation-contracts.ts)
  // -- the one and only authoritative generation intent. Never a browser
  // prompt.
  sealedRequest Json

  // DB-level idempotency backstop, identical precedent to
  // PhotoPreviewGeneration.requestFingerprint.
  requestFingerprint String @db.VarChar(64)

  variationIndex Int @default(0)

  // REQUESTED -> PROCESSING -> COMPLETED | FAILED. See model header comment
  // for why a separate SUBMITTED value was deliberately not added.
  status String

  // How many real provider SUBMIT attempts have been claimed for this row
  // (never polling -- polling is free, submission is what can cost money).
  // Bounded by MAX_PROVIDER_SUBMIT_ATTEMPTS_PER_GENERATION
  // (video-generation-execution-repository.ts), same shape as Photo
  // Preview's own attemptCount.
  attemptCount Int @default(0)

  // Set ATOMICALLY, immediately after a real provider submit() call
  // succeeds -- this is the single most important field in this table
  // (Decision Lock section 6/10, task §10/§12): once non-null, every
  // recovery path must poll THIS operation, never submit a second one.
  providerOperationId String?

  generatedVideoAssetId String?

  // Stage 2 hardening: a SEPARATE atomic claim from the submit claim above
  // -- guards the "provider says done, now download/persist/complete"
  // window against two concurrent pollers both observing done:true and
  // both downloading the video / creating a VideoAsset / metering
  // SUCCEEDED (video-generation-execution-repository.ts's own
  // claimVideoDemonstrationGenerationForCompletionProcessing). Reset to
  // null whenever a fresh submit attempt starts (markVideoDemonstrationGenerationSubmitted),
  // so a stale value from an earlier attempt never blocks a later one.
  // Stale (crashed mid-completion-processing) claims are recoverable the
  // same way a stale submit claim is.
  completionClaimedAt DateTime? @db.Timestamp(6)

  // Stage 3: when the recovery worker's sweep should next consider this
  // row due for a poll attempt -- bounded backoff
  // (video-generation-execution-service.ts's own
  // computeVideoDemonstrationNextPollDelayMs), never a tight loop. Purely
  // advisory for the SWEEP's own "which rows are due" query -- an
  // explicit, direct /execute call always polls immediately regardless of
  // this value (task §6: this governs automated cadence, not a user's own
  // explicit status check). Null while REQUESTED or PROCESSING-without-an-
  // operation-id (not yet in the polling phase at all).
  nextPollAt DateTime? @db.Timestamp(6)

  // Safe, closed-vocabulary failure codes only -- never a raw provider
  // stack trace or secret.
  errorCode     String?
  errorMetadata Json?

  requestedAt DateTime  @default(now()) @db.Timestamp(6)
  submittedAt DateTime? @db.Timestamp(6)
  startedAt   DateTime? @db.Timestamp(6)
  completedAt DateTime? @db.Timestamp(6)
  failedAt    DateTime? @db.Timestamp(6)

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)

  owner  User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client Client @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([requestFingerprint])
  @@index([ownerUserId, clientId])
  @@index([photoPreviewGenerationId, ownerUserId, clientId])
  @@index([status])
}
