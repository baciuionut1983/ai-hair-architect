generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         String
  locale       String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id          String   @id @default(uuid())
  name        String
  ownerUserId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerUserId])
}

model Analysis {
  id                   String   @id
  clientId             String
  ownerUserId          String
  goal                 String
  hairType             String
  density              String
  porosity             String
  phase                String
  clarificationRound   Int
  confidenceScore      Float
  uncertaintyReasons   Json
  followUpQuestions    Json
  recommendations      Json
  safetyNotes          Json
  faceShape            String?
  headShape            String?
  hairLength           String?
  hairTexture          String?
  hairCondition        String?
  growthPattern        String?
  targetShape          String?
  technicalCutPlan     Json?
  clarificationAnswers Json
  imageAssetId         String?
  imageAnalysisId      String?
  m8DraftCreatedAt     DateTime?
  m8FinalizedAt        DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  imageAsset           ImageAsset?         @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  imageAnalysis        ImageAnalysis?      @relation(fields: [imageAnalysisId], references: [id], onDelete: SetNull)

  @@index([ownerUserId])
  @@index([clientId])
  @@index([ownerUserId, clientId])
  @@index([imageAssetId])
  @@index([imageAnalysisId])
}

model ImageAsset {
  id                  String   @id @default(uuid())
  fileName            String
  mimeType            String
  sizeBytes           Int
  ownerUserId         String
  clientId            String
  storagePath         String
  exifStripped        Boolean  @default(false)
  normalizedOrientation Int    @default(0)
  uploadedAt          DateTime @default(now())
  deletedAt           DateTime?
  retentionDeletesAt  DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  analyses            ImageAnalysis[]
  analysisResults     Analysis[]

  @@index([ownerUserId])
  @@index([clientId])
  @@index([ownerUserId, clientId])
  @@index([deletedAt])
}

model ImageAnalysis {
  id                  String   @id @default(uuid())
  assetId             String
  status              String   @default("draft")
  providerName        String   @default("manual-only")
  modelVersion        String   @default("mock-1.0")
  analysisPayload     Json     @default("{}")
  confidences         Json     @default("{}")
  unknownFields       Json     @default("[]")
  warnings            Json     @default("[]")
  limitations         Json     @default("[]")
  consentTimestamp    DateTime @default(now())
  deletedAt           DateTime?
  retentionDeletesAt  DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  asset               ImageAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reviews             ImageAnalysisReview[]
  analysisResults     Analysis[]

  @@index([assetId])
  @@index([status])
  @@index([deletedAt])
}

model ImageAnalysisReview {
  id                  String   @id @default(uuid())
  analysisId          String
  reviewedByUserId    String
  manualCorrections   Json     @default("{}")
  confirmationTimestamp DateTime?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  analysis            ImageAnalysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([reviewedByUserId])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String   @db.Uuid
  action        String
  resourceType  String
  resourceId    String?
  status        String
  metadata      Json
  createdAt     DateTime @default(now()) @db.Timestamp(6)

  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
  @@index([status])
  @@index([actorUserId, createdAt])
}
