model OpsRetentionRun {
  id                      String    @id @default(cuid())
  ownerUserId             String    @db.Uuid
  mode                    String    @db.VarChar(16)
  status                  String    @db.VarChar(32)
  olderThanDays           Int
  reasonAuditSafe         String?   @db.VarChar(200)
  executionIdempotencyKey String?   @db.VarChar(190)
  idempotencyFingerprint  String?   @db.VarChar(64)
  advisoryLockKey         String    @db.VarChar(32)
  startedAt               DateTime  @db.Timestamp(6)
  finishedAt              DateTime? @db.Timestamp(6)
  pushQueueAffected       Int
  auditEventsAffected     Int
  errorCode               String?   @db.VarChar(80)
  errorMessageSafe        String?   @db.VarChar(500)
  createdAt               DateTime  @default(now()) @db.Timestamp(6)

  @@unique([ownerUserId, executionIdempotencyKey])
  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, startedAt])
}

// M36: distinct from OpsRetentionRun (which purges push-queue/audit-log rows
// on a relative "olderThanDays" window). This purge operates on an absolute
// per-row expiry (ImageAsset.retentionDeletesAt) and must clear a real
// external object (S3 or local file) before the DB row is ever removed, so
// it gets its own outcome shape (eligible/purged/failed) instead of reusing
// OpsRetentionRun's push/audit-specific counters.
model OpsImageAssetRetentionRun {
  id                      String    @id @default(cuid())
  ownerUserId             String    @db.Uuid
  mode                    String    @db.VarChar(16)
  status                  String    @db.VarChar(32)
  reasonAuditSafe         String?   @db.VarChar(200)
  executionIdempotencyKey String?   @db.VarChar(190)
  idempotencyFingerprint  String?   @db.VarChar(64)
  advisoryLockKey         String    @db.VarChar(32)
  startedAt               DateTime  @db.Timestamp(6)
  finishedAt              DateTime? @db.Timestamp(6)
  eligibleCount           Int
  purgedCount             Int
  failedCount             Int
  errorCode               String?   @db.VarChar(80)
  errorMessageSafe        String?   @db.VarChar(500)
  createdAt               DateTime  @default(now()) @db.Timestamp(6)

  @@unique([ownerUserId, executionIdempotencyKey])
  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, startedAt])
}

model OpsPushQueueEntry {
  id          String    @id @default(cuid())
  ownerUserId String    @db.Uuid
  channel     String    @db.VarChar(16)
  title       String    @db.VarChar(160)
  body        String    @db.Text
  status      String    @db.VarChar(16)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)

  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, status])
}

model WebhookEndpoint {
  id              String    @id @default(cuid())
  ownerUserId     String
  owner           User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name            String    @db.VarChar(255)
  url             String    @db.VarChar(2048)
  // Deprecated compatibility field retained only for M9D route compatibility.
  // M10A introduces WebhookEndpointSecretVersion.secretEncrypted as the forward-compatible
  // source of truth for secret material. This legacy column is planned for removal only
  // after all routes have migrated to the versioned secret model in a later milestone.
  secretEncrypted String    @db.Text
  enabled         Boolean   @default(true)
  deletedAt       DateTime? @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @db.Timestamp(6)

  secretVersions WebhookEndpointSecretVersion[]
  deliveries     WebhookDelivery[]

  @@unique([ownerUserId, name])
  @@unique([id, ownerUserId])
  @@index([ownerUserId])
  @@index([ownerUserId, enabled])
  @@index([ownerUserId, enabled, deletedAt])
}

model WebhookEndpointSecretVersion {
  id                String    @id @default(cuid())
  webhookEndpointId String
  ownerUserId       String
  version           Int
  // This is the new forward-compatible encrypted secret store introduced in M10A.
  // New delivery records bind to a specific secret version through a composite FK.
  secretEncrypted   String    @db.Text
  // The hardcoded default is intentional: M9D already signs with HMAC-SHA256 using the v1 canonical format,
  // so backfilled and newly created version rows must agree on the same explicit scheme string.
  signatureScheme   String    @default("hmac_sha256_v1") @db.VarChar(64)
  isCurrent         Boolean   @default(false)
  createdAt         DateTime  @default(now()) @db.Timestamp(6)
  retiredAt         DateTime? @db.Timestamp(6)
  retainUntil       DateTime? @db.Timestamp(6)

  endpoint   WebhookEndpoint   @relation(fields: [webhookEndpointId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@unique([id, webhookEndpointId, ownerUserId])
  @@unique([webhookEndpointId, version])
  @@index([webhookEndpointId, createdAt])
  @@index([ownerUserId, retainUntil])
}

model WebhookEvent {
  id                     String   @id @default(cuid())
  ownerUserId            String
  eventType              String   @db.VarChar(120)
  schemaVersion          String   @db.VarChar(16)
  producerIdempotencyKey String?  @db.VarChar(190)
  resourceType           String   @db.VarChar(80)
  resourceId             String   @db.VarChar(120)
  occurredAt             DateTime @db.Timestamp(6)
  payload                Json
  dispatchEligible       Boolean
  auditOnly              Boolean
  sensitivity            String   @db.VarChar(32)
  createdAt              DateTime @default(now()) @db.Timestamp(6)

  deliveries WebhookDelivery[]

  @@unique([id, ownerUserId])
  @@index([ownerUserId, createdAt])
  @@index([eventType, occurredAt])
}

model WebhookDelivery {
  id                      String                @id @default(cuid())
  ownerUserId             String
  webhookEventId          String
  webhookEndpointId       String
  secretVersionId         String
  status                  WebhookDeliveryStatus @default(pending)
  attemptCount            Int                   @default(0)
  maxAttempts             Int                   @default(6)
  connectivityMaxAttempts Int                   @default(3)
  nextAttemptAt           DateTime?             @db.Timestamp(6)
  lastAttemptAt           DateTime?             @db.Timestamp(6)
  deliveredAt             DateTime?             @db.Timestamp(6)
  failedTerminalAt        DateTime?             @db.Timestamp(6)
  leaseToken              String?               @db.VarChar(120)
  leaseExpiresAt          DateTime?             @db.Timestamp(6)
  lastFailureDomain       WebhookFailureDomain?
  lastFailureCode         WebhookFailureCode    @default(none)
  idempotencyKey          String                @db.VarChar(190)
  targetUrlSnapshot       String                @db.VarChar(2048)
  signatureSchemeSnapshot String                @db.VarChar(64)
  secretVersionSnapshot   Int
  eventTypeSnapshot       String                @db.VarChar(120)
  approvedHeadersSnapshot Json?
  createdAt               DateTime              @default(now()) @db.Timestamp(6)
  updatedAt               DateTime              @updatedAt @db.Timestamp(6)

  event         WebhookEvent                 @relation(fields: [webhookEventId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  endpoint      WebhookEndpoint              @relation(fields: [webhookEndpointId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  secretVersion WebhookEndpointSecretVersion @relation(fields: [secretVersionId, webhookEndpointId, ownerUserId], references: [id, webhookEndpointId, ownerUserId], onDelete: Restrict)
  attempts      WebhookDeliveryAttempt[]

  @@unique([webhookEndpointId, webhookEventId])
  @@unique([ownerUserId, idempotencyKey])
  @@index([ownerUserId, status, nextAttemptAt])
  @@index([ownerUserId, failedTerminalAt])
  @@index([ownerUserId, leaseExpiresAt])
  @@index([webhookEndpointId, createdAt])
  @@index([secretVersionId])
}

model WebhookDeliveryAttempt {
  id                String                 @id @default(cuid())
  webhookDeliveryId String
  attemptNumber     Int
  startedAt         DateTime               @db.Timestamp(6)
  completedAt       DateTime?              @db.Timestamp(6)
  durationMs        Int?
  httpStatus        Int?
  outcome           WebhookAttemptOutcome?
  failureDomain     WebhookFailureDomain?
  failureCode       WebhookFailureCode?
  errorCode         String?                @db.VarChar(80)
  errorMessageSafe  String?                @db.VarChar(500)
  responseTruncated Boolean                @default(false)
  createdAt         DateTime               @default(now()) @db.Timestamp(6)

  delivery WebhookDelivery @relation(fields: [webhookDeliveryId], references: [id], onDelete: Restrict)

  @@unique([webhookDeliveryId, attemptNumber])
  @@index([webhookDeliveryId, attemptNumber])
  @@index([createdAt])
}

model BillingCustomer {
  id                 String          @id @default(cuid())
  ownerUserId        String
  provider           BillingProvider @default(stripe)
  providerCustomerId String          @db.VarChar(255)
  createdAt          DateTime        @default(now()) @db.Timestamp(6)
  updatedAt          DateTime        @updatedAt @db.Timestamp(6)

  owner         User                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subscriptions BillingSubscription[]

  @@unique([id, ownerUserId])
  @@unique([provider, providerCustomerId])
  @@unique([ownerUserId, provider])
  @@index([ownerUserId])
}

// M38: at most one in-flight checkout per (ownerUserId, provider), enforced
// by the composite primary key itself -- a second concurrent request can
// never insert a second row, on any number of app instances, since this is
// a single shared Postgres constraint, not an in-process lock. expiresAt is
// what makes an abandoned/expired checkout reclaimable without any cleanup
// job: a row past its expiresAt is simply treated as free by the ordinary
// acquire query. See acquireCheckoutLock in billing-repository.ts.
model BillingCheckoutLock {
  ownerUserId       String
  provider          BillingProvider @default(stripe)
  plan              String          @db.VarChar(64)
  providerSessionId String?         @db.VarChar(255)
  acquiredAt        DateTime        @default(now()) @db.Timestamp(6)
  expiresAt         DateTime        @db.Timestamp(6)
  createdAt         DateTime        @default(now()) @db.Timestamp(6)
  updatedAt         DateTime        @updatedAt @db.Timestamp(6)

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([ownerUserId, provider])
  @@index([expiresAt])
}

model BillingSubscription {
  id                        String                    @id @default(cuid())
  ownerUserId               String
  billingCustomerId         String
  provider                  BillingProvider           @default(stripe)
  providerSubscriptionId    String                    @db.VarChar(255)
  planKey                   String                    @db.VarChar(64)
  status                    BillingSubscriptionStatus
  currentPeriodStart        DateTime?                 @db.Timestamp(6)
  currentPeriodEnd          DateTime?                 @db.Timestamp(6)
  cancelAtPeriodEnd         Boolean                   @default(false)
  canceledAt                DateTime?                 @db.Timestamp(6)
  lastAppliedEventCreatedAt DateTime?                 @db.Timestamp(6)
  lastAppliedEventId        String?                   @db.VarChar(255)
  createdAt                 DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime                  @updatedAt @db.Timestamp(6)

  owner    User             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer BillingCustomer  @relation(fields: [billingCustomerId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  payments BillingPayment[]

  @@unique([id, ownerUserId])
  @@unique([provider, providerSubscriptionId])
  @@index([ownerUserId, status])
  @@index([billingCustomerId])
}

model BillingPayment {
  id                      String               @id @default(cuid())
  ownerUserId             String
  billingSubscriptionId   String?
  provider                BillingProvider      @default(stripe)
  providerInvoiceId       String               @db.VarChar(255)
  providerPaymentIntentId String?              @db.VarChar(255)
  amountCents             Int
  currency                String               @db.VarChar(3)
  status                  BillingPaymentStatus
  paidAt                  DateTime?            @db.Timestamp(6)
  failedAt                DateTime?            @db.Timestamp(6)
  failureCode             String?              @db.VarChar(80)
  createdAt               DateTime             @default(now()) @db.Timestamp(6)
  updatedAt               DateTime             @updatedAt @db.Timestamp(6)

  owner        User                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subscription BillingSubscription? @relation(fields: [billingSubscriptionId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, providerInvoiceId])
  @@index([ownerUserId, createdAt])
  @@index([billingSubscriptionId])
}

model BillingWebhookEvent {
  id                     String                    @id @default(cuid())
  provider               BillingProvider           @default(stripe)
  providerEventId        String                    @db.VarChar(255)
  eventType              String                    @db.VarChar(120)
  apiVersion             String?                   @db.VarChar(32)
  status                 BillingWebhookEventStatus @default(received)
  ownerUserId            String?
  providerCustomerId     String?                   @db.VarChar(255)
  providerSubscriptionId String?                   @db.VarChar(255)
  providerInvoiceId      String?                   @db.VarChar(255)
  eventCreatedAt         DateTime                  @db.Timestamp(6)
  receivedAt             DateTime                  @default(now()) @db.Timestamp(6)
  lastAttemptedAt        DateTime?                 @db.Timestamp(6)
  processedAt            DateTime?                 @db.Timestamp(6)
  attemptCount           Int                       @default(0)
  lastFailureCode        String?                   @db.VarChar(80)
  createdAt              DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt              DateTime                  @updatedAt @db.Timestamp(6)

  @@unique([provider, providerEventId])
  @@index([ownerUserId, receivedAt])
  @@index([status, receivedAt])
  @@index([providerSubscriptionId])
}
