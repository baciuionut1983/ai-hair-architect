generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WebhookDeliveryStatus {
  pending
  dispatching
  delivered
  failed_retryable
  failed_terminal
  canceled
}

enum WebhookAttemptOutcome {
  success
  retryable_failure
  terminal_failure
}

enum WebhookFailureDomain {
  destination
  security
  configuration
  platform_internal
}

enum WebhookFailureCode {
  none
  timeout
  connection_refused
  connection_reset
  host_unreachable
  network_unreachable
  dns_temporary
  dns_not_found
  http_3xx_redirect_blocked
  http_408
  http_425
  http_429
  http_5xx
  http_4xx_non_retryable
  ssrf_blocked
  tls_certificate_error
  invalid_url
  endpoint_disabled
  endpoint_deleted
  internal_transient
  internal_persistent
}

enum OpsBackupRestoreRunStatus {
  started
  completed
  failed
  indeterminate
}

enum OpsBackupRestoreMaintenanceRunStatus {
  running
  completed
  failed
}

enum OpsBackupRestoreRetentionRunStatus {
  running
  completed
  failed
}

enum AppointmentReminderType {
  appointment
  follow_up
  maintenance
}

enum NotificationType {
  appointment
  follow_up
  maintenance
}

enum ImageAssetStorageState {
  pending_upload
  available
  delete_pending
  deleted
  quarantined
}

enum BillingProvider {
  stripe
}

enum BillingSubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum BillingPaymentStatus {
  pending
  succeeded
  failed
  refunded
  disputed
}

enum BillingWebhookEventStatus {
  received
  processing
  processed
  ignored_out_of_order
  ignored_unsupported
  failed_retryable
  failed_terminal
}

model User {
  id                                String                             @id @default(uuid())
  email                             String                             @unique
  passwordHash                      String
  role                              String
  locale                            String
  // M26: null means unverified. No @default here on purpose -- every row
  // that exists before the M26 migration is explicitly backfilled to a
  // real, non-null timestamp by that migration itself; every row created
  // afterward starts genuinely null until the owner completes email
  // verification. A column default would blur that distinction.
  emailVerifiedAt                   DateTime?
  createdAt                         DateTime                           @default(now())
  sessions                          Session[]
  clients                           Client[]
  analyses                          Analysis[]
  consultations                     Consultation[]
  appointments                      Appointment[]
  notifications                     Notification[]
  webhooks                          WebhookEndpoint[]
  billingCustomers                  BillingCustomer[]
  billingSubscriptions              BillingSubscription[]
  billingPayments                   BillingPayment[]
  billingCheckoutLocks              BillingCheckoutLock[]
  imageAnalysisProviderAttempts     ImageAnalysisProviderAttempt[]
  videoLessons                      VideoLesson[]
  emailNotifications                EmailNotification[]
  authTokens                        AuthToken[]
  clientPhotos                      ClientPhoto[]
  clientFormulas                    ClientFormula[]
  clientTreatments                  ClientTreatment[]
  analysisCorrections               AnalysisCorrection[]
  consultationMessages              ConsultationMessage[]
  professionalMemories              ProfessionalMemory[]               @relation("MemoryOwner")
  professionalMemoryAudits          ProfessionalMemoryAudit[]          @relation("MemoryAuditActor")
  voiceTranscripts                  VoiceTranscript[]
  aiUsageEvents                     AiUsageEvent[]
  // Phase 2 (AI Proposed Look). Virtual back-relation only -- produces no
  // column or constraint on "User"; the FK lives on "AnalysisProposal".
  analysisProposals                 AnalysisProposal[]
  // Technical Visual Map, Stage 1. Virtual back-relation only -- produces no
  // column or constraint on "User"; the FK lives on "TechnicalVisualMap".
  technicalVisualMaps               TechnicalVisualMap[]
  // Technical Visual Map, Stage 5A. Virtual back-relation only -- produces
  // no column or constraint on "User"; the FK lives on
  // "TechnicalVisualMapSpatialBinding".
  technicalVisualMapSpatialBindings TechnicalVisualMapSpatialBinding[]
  // Real AI Photo Preview, Stage 1. Virtual back-relation only -- produces
  // no column or constraint on "User"; the FK lives on
  // "PhotoPreviewGeneration".
  photoPreviewGenerations           PhotoPreviewGeneration[]
  // Real AI Video Demonstration, Stage 1. Virtual back-relation only.
  videoDemonstrationGenerations     VideoDemonstrationGeneration[]
  videoAssets                       VideoAsset[]
}

model Session {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum AuthTokenPurpose {
  email_verification
  password_reset
}

// M26: the raw token is never persisted, only its SHA-256 hash. At most one
// unused row may exist per (userId, purpose) at a time -- issuing a new
// token for the same user+purpose deletes any prior unused one first, so
// there is never more than one active token to guess against.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  tokenHash String           @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model Client {
  id                                String                             @id @default(uuid())
  ownerUserId                       String
  fullName                          String                             @db.VarChar(200)
  email                             String?                            @db.VarChar(320)
  phone                             String?                            @db.VarChar(40)
  notes                             String?                            @db.VarChar(4000)
  deletedAt                         DateTime?                          @db.Timestamp(6)
  createdAt                         DateTime                           @default(now()) @db.Timestamp(6)
  updatedAt                         DateTime                           @updatedAt @db.Timestamp(6)
  owner                             User                               @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  analyses                          Analysis[]
  consultations                     Consultation[]
  appointments                      Appointment[]
  clientPhotos                      ClientPhoto[]
  clientFormulas                    ClientFormula[]
  clientTreatments                  ClientTreatment[]
  analysisCorrections               AnalysisCorrection[]
  consultationMessages              ConsultationMessage[]
  professionalMemories              ProfessionalMemory[]
  voiceTranscripts                  VoiceTranscript[]
  // Phase 2 (AI Proposed Look). Virtual back-relation only -- produces no
  // column or constraint on "Client"; the FK lives on "AnalysisProposal".
  analysisProposals                 AnalysisProposal[]
  // Technical Visual Map, Stage 1. Virtual back-relation only -- produces no
  // column or constraint on "Client"; the FK lives on "TechnicalVisualMap".
  technicalVisualMaps               TechnicalVisualMap[]
  // Technical Visual Map, Stage 5A. Virtual back-relation only -- produces
  // no column or constraint on "Client"; the FK lives on
  // "TechnicalVisualMapSpatialBinding".
  technicalVisualMapSpatialBindings TechnicalVisualMapSpatialBinding[]
  // Real AI Photo Preview, Stage 1. Virtual back-relation only -- produces
  // no column or constraint on "Client"; the FK lives on
  // "PhotoPreviewGeneration".
  photoPreviewGenerations           PhotoPreviewGeneration[]
  // Real AI Video Demonstration, Stage 1. Virtual back-relation only.
  videoDemonstrationGenerations     VideoDemonstrationGeneration[]
  videoAssets                       VideoAsset[]

  @@unique([id, ownerUserId])
  @@index([ownerUserId, deletedAt, updatedAt, id])
}

model Analysis {
  id                   String                @id
  clientId             String
  ownerUserId          String
  goal                 String
  hairType             String
  density              String
  porosity             String
  phase                String
  clarificationRound   Int
  confidenceScore      Float
  uncertaintyReasons   Json
  followUpQuestions    Json
  recommendations      Json
  safetyNotes          Json
  faceShape            String?
  headShape            String?
  hairLength           String?
  hairTexture          String?
  hairCondition        String?
  growthPattern        String?
  targetShape          String?
  technicalCutPlan     Json?
  colorPlan            Json?
  desiredColorResult   String?
  grayPercentage       String?
  treatmentPlan        Json?
  scalpCondition       String?
  treatmentGoalDetail  String?
  clarificationAnswers Json
  imageAssetId         String?
  imageAnalysisId      String?
  m8DraftCreatedAt     DateTime?
  m8FinalizedAt        DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  owner                User                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client               Client                @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  imageAsset           ImageAsset?           @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  imageAnalysis        ImageAnalysis?        @relation(fields: [imageAnalysisId], references: [id], onDelete: SetNull)
  consultations        Consultation[]
  sourcedFormulas      ClientFormula[]
  sourcedTreatments    ClientTreatment[]
  corrections          AnalysisCorrection[]
  consultationMessages ConsultationMessage[]
  // Phase 2 (AI Proposed Look). Virtual back-relation only -- produces no
  // column or constraint on "Analysis"; the composite FK
  // (analysisId, ownerUserId, clientId) lives on "AnalysisProposal" and
  // targets this model's existing @@unique([id, ownerUserId, clientId]).
  analysisProposals    AnalysisProposal[]

  @@unique([id, ownerUserId, clientId])
  @@index([ownerUserId])
  @@index([clientId])
  @@index([ownerUserId, clientId])
  @@index([imageAssetId])
  @@index([imageAnalysisId])
}

// M28: real Postgres persistence for the client CRM history that had been
// in-memory only (milestone1-store.ts) since the M2/M3 era. ClientPhoto is
// the CRM gallery entry (caption + URL), deliberately distinct from
// ImageAsset (the real object-storage-backed photo used by the M15/M18
// Gemini vision pipeline) -- the two are not unified in M28.
model ClientPhoto {
  id          String   @id @default(uuid())
  clientId    String
  ownerUserId String
  imageUrl    String
  caption     String?
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  owner  User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client Client @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)

  @@index([clientId, ownerUserId, createdAt, id])
}

// M28: sourceAnalysisId is a nullable, purely-traceability link to the
// Analysis (M8/M27) whose TechnicalCutPlan/ColorPlan/TreatmentPlan may have
// informed this real, professional-logged service. It is never populated
// automatically and never required -- a formula logged with no AI
// involvement at all remains fully valid. The composite FK (with
// ownerUserId+clientId) makes it impossible at the database level to link
// an Analysis belonging to a different owner or a different client.
model ClientFormula {
  id               String   @id @default(uuid())
  clientId         String
  ownerUserId      String
  formulaName      String
  formulaDetails   String
  sourceAnalysisId String?
  createdAt        DateTime @default(now()) @db.Timestamp(6)

  owner          User      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client         Client    @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  // Restrict, not SetNull: a composite SetNull would need to null out
  // ownerUserId/clientId too (same relation), but those are required --
  // Prisma warns this is unsafe. Restrict also matches the project's
  // dominant convention for owner/client FKs. Analysis has no delete route
  // today, so this is theoretical protection: an Analysis referenced by
  // CRM history cannot be deleted until the link is explicitly removed in
  // a future milestone -- accepted and intended, for traceability.
  sourceAnalysis Analysis? @relation(fields: [sourceAnalysisId, ownerUserId, clientId], references: [id, ownerUserId, clientId], onDelete: Restrict, onUpdate: Cascade)

  @@index([clientId, ownerUserId, createdAt, id])
  @@index([sourceAnalysisId])
}

// M28: same shape and same sourceAnalysisId semantics as ClientFormula,
// for treatments actually performed rather than color formulas applied.
model ClientTreatment {
  id               String   @id @default(uuid())
  clientId         String
  ownerUserId      String
  treatmentName    String
  treatmentDetails String
  sourceAnalysisId String?
  createdAt        DateTime @default(now()) @db.Timestamp(6)

  owner          User      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client         Client    @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  // See ClientFormula.sourceAnalysis for why Restrict (not SetNull) is used.
  sourceAnalysis Analysis? @relation(fields: [sourceAnalysisId, ownerUserId, clientId], references: [id, ownerUserId, clientId], onDelete: Restrict, onUpdate: Cascade)

  @@index([clientId, ownerUserId, createdAt, id])
  @@index([sourceAnalysisId])
}

enum AnalysisFieldSource {
  visual_ai
  stylist_confirmed
  client_reported
  historical
  assumed
}

// Conversational Professional AI milestone: an append-only, never-mutated
// audit trail of every structured field correction ever applied to an
// Analysis -- whoever/whatever triggered it (a manual form edit, a
// conversational message the stylist confirmed, a future input channel).
// Distinct from ImageAnalysisReview (M18), which is scoped to the pre-M8
// draft ImageAnalysis stage before a real Analysis exists; this is scoped
// to the final Analysis (post-clarification, with technicalCutPlan/
// colorPlan/treatmentPlan). No correctedByUserId: this product has no real
// multi-stylist workspace today (see WorkspaceRecord in contracts.ts --
// legacy/in-memory only, no Prisma model), so ownerUserId is always the
// acting user; adding a separate attribution column now would model a
// capability that does not actually exist yet.
model AnalysisCorrection {
  id            String              @id @default(uuid())
  analysisId    String
  ownerUserId   String
  clientId      String
  fieldName     String              @db.VarChar(64)
  previousValue Json?
  newValue      Json
  source        AnalysisFieldSource
  reason        String?             @db.VarChar(2000)
  createdAt     DateTime            @default(now()) @db.Timestamp(6)

  owner    User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client   Client   @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  analysis Analysis @relation(fields: [analysisId, ownerUserId, clientId], references: [id, ownerUserId, clientId], onDelete: Restrict, onUpdate: Cascade)

  @@index([analysisId, ownerUserId, clientId, createdAt])
  @@index([ownerUserId, createdAt])
}

enum ConsultationMessageRole {
  stylist
  assistant
}

// Conversational AI history -- client-scoped rather than strictly
// analysis-scoped (a conversation may start before a specific Analysis
// exists, e.g. discussing goals before the first photo). Append-only, never
// mutated. proposedCorrection is a suggestion only, exactly as returned by
// the AI provider -- it is never applied automatically; only an explicit
// call to POST /api/v1/analysis/{id}/correct (creating a real
// AnalysisCorrection row) ever changes professional data.
model ConsultationMessage {
  id                     String                  @id @default(uuid())
  ownerUserId            String
  clientId               String
  analysisId             String?
  role                   ConsultationMessageRole
  content                String                  @db.VarChar(4000)
  proposedCorrection     Json?
  // A suggested ProfessionalMemory candidate, exactly as returned by the AI
  // provider -- like proposedCorrection, this is ALWAYS only a suggestion.
  // Nothing here ever creates a ProfessionalMemory row automatically; only
  // an explicit, separate call to POST /api/v1/clients/{id}/memories (with
  // confirmed: true) does that.
  proposedMemory         Json?
  // Regression: Confirm/Edit/Reject reappeared as active buttons on
  // already-decided proposedMemory cards after every reload, because the
  // decision (confirmedMemoryIds/rejectedMemoryIds in consultation-chat.tsx)
  // lived only in React state, reset to empty on every mount -- Reject made
  // no API call at all, and Confirm's own POST /api/v1/clients/{id}/memories
  // never wrote anything back onto this row. null = no decision yet
  // ("pending", may show the buttons); "confirmed"/"rejected" = the real,
  // persisted, final state, reconstructed on every reload instead of a
  // client-side guess. Never set directly on create -- only via
  // markConsultationMessageMemoryDecision, and only once (the write is
  // WHERE proposedMemoryDecision IS NULL, so a decision can never be
  // silently overwritten by a later, unrelated call).
  proposedMemoryDecision String?
  createdAt              DateTime                @default(now()) @db.Timestamp(6)

  owner    User      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client   Client    @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  analysis Analysis? @relation(fields: [analysisId, ownerUserId, clientId], references: [id, ownerUserId, clientId], onDelete: Restrict, onUpdate: Cascade)

  @@index([ownerUserId, clientId, createdAt])
  @@index([analysisId, ownerUserId, clientId])
}

enum ProfessionalMemoryScope {
  client_specific
  stylist_specific
  shared_knowledge
}

enum ProfessionalMemoryKind {
  fact
  professional_rule
  preference
  outcome
  ai_observation
}

enum ProfessionalMemoryStatus {
  pending
  active
  revoked
}

enum ProfessionalMemorySource {
  typed
  voice_transcript
  consultation
  analysis
  outcome_feedback
  import
}

// A single, owner-scoped knowledge ledger shared by Consult AI and its
// agents. "workspace" currently equals ownerUserId because the product has
// no persisted multi-user Workspace model. Nothing becomes active without
// an explicit confirm action; personal rules are never promoted globally.
model ProfessionalMemory {
  id              String                   @id @default(uuid())
  ownerUserId     String
  clientId        String?
  scope           ProfessionalMemoryScope
  kind            ProfessionalMemoryKind
  status          ProfessionalMemoryStatus @default(pending)
  source          ProfessionalMemorySource
  content         String                   @db.VarChar(4000)
  provenance      Json
  confidence      Float                    @default(1)
  createdByUserId String
  confirmedAt     DateTime?                @db.Timestamp(6)
  revokedAt       DateTime?                @db.Timestamp(6)
  createdAt       DateTime                 @default(now()) @db.Timestamp(6)
  updatedAt       DateTime                 @updatedAt @db.Timestamp(6)

  owner  User                      @relation("MemoryOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  client Client?                   @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  audits ProfessionalMemoryAudit[]

  @@index([ownerUserId, status, scope, updatedAt])
  @@index([ownerUserId, clientId, status, updatedAt])
}

model ProfessionalMemoryAudit {
  id          String   @id @default(uuid())
  memoryId    String
  ownerUserId String
  actorUserId String
  action      String   @db.VarChar(32)
  details     Json
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  memory ProfessionalMemory @relation(fields: [memoryId], references: [id], onDelete: Restrict)
  actor  User               @relation("MemoryAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, memoryId, createdAt])
}

// Transcription is a draft input channel, not memory. A separate explicit
// POST to the memory endpoint is required to create/confirm knowledge.
model VoiceTranscript {
  id              String   @id @default(uuid())
  ownerUserId     String
  clientId        String?
  transcript      String   @db.VarChar(4000)
  provider        String   @db.VarChar(64)
  providerRequest String?  @db.VarChar(200)
  createdAt       DateTime @default(now()) @db.Timestamp(6)

  owner  User    @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  client Client? @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)

  @@index([ownerUserId, clientId, createdAt])
}

model Consultation {
  id          String   @id @default(uuid())
  ownerUserId String
  clientId    String
  analysisId  String
  summary     String   @db.VarChar(4000)
  nextSteps   Json     @default("[]")
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  client      Client   @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  analysis    Analysis @relation(fields: [analysisId, ownerUserId, clientId], references: [id, ownerUserId, clientId], onDelete: Restrict)

  @@index([ownerUserId, createdAt, id])
  @@index([ownerUserId, clientId, createdAt, id])
  @@index([analysisId, ownerUserId, clientId])
}

model Appointment {
  id                    String                  @id @default(uuid())
  ownerUserId           String
  clientId              String
  title                 String                  @db.VarChar(200)
  startsAt              DateTime                @db.Timestamp(6)
  reminderMinutesBefore Int                     @default(1440)
  reminderType          AppointmentReminderType
  reminderSentAt        DateTime?               @db.Timestamp(6)
  notes                 String                  @default("") @db.VarChar(4000)
  createdAt             DateTime                @default(now()) @db.Timestamp(6)
  updatedAt             DateTime                @updatedAt @db.Timestamp(6)
  owner                 User                    @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client                Client                  @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  notifications         Notification[]

  @@unique([id, ownerUserId, clientId])
  @@index([ownerUserId, startsAt, id])
  @@index([ownerUserId, clientId, startsAt, id])
  @@index([ownerUserId, reminderSentAt, startsAt, id])
}

model Notification {
  id                   String           @id @default(uuid())
  ownerUserId          String
  type                 NotificationType
  title                String           @db.VarChar(240)
  message              String           @db.VarChar(1000)
  relatedClientId      String
  relatedAppointmentId String
  createdAt            DateTime         @default(now()) @db.Timestamp(6)
  readAt               DateTime?        @db.Timestamp(6)
  owner                User             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relatedAppointment   Appointment      @relation(fields: [relatedAppointmentId, ownerUserId, relatedClientId], references: [id, ownerUserId, clientId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([relatedAppointmentId, ownerUserId, type])
  @@index([ownerUserId, createdAt, id])
  @@index([ownerUserId, readAt, createdAt, id])
}

model ImageAsset {
  id                    String                  @id @default(uuid())
  fileName              String
  mimeType              String
  sizeBytes             Int
  ownerUserId           String
  clientId              String
  storagePath           String
  storageBackend        String?                 @db.VarChar(16)
  storageBucketAlias    String?                 @db.VarChar(64)
  storageKey            String?                 @db.VarChar(512)
  storageVersionId      String?                 @db.VarChar(1024)
  storageEtag           String?                 @db.VarChar(256)
  contentSha256         String?                 @db.Char(64)
  storageState          ImageAssetStorageState?
  storageMigratedAt     DateTime?               @db.Timestamp(6)
  objectDeletedAt       DateTime?               @db.Timestamp(6)
  lastStorageErrorCode  String?                 @db.VarChar(80)
  exifStripped          Boolean                 @default(false)
  normalizedOrientation Int                     @default(0)

  // Real AI Photo Preview, Stage 2 -- the provenance/trust-boundary
  // discriminator Stage 0's own audit identified as a real gap: every row
  // before this stage is implicitly "a client upload", and the default
  // ("upload") keeps that true for all of them with no backfill needed.
  // "ai_generated" is set ONLY by photo-preview-output-storage.ts, for a
  // Photo Preview provider's own output -- never by the ordinary upload
  // path. Plain string, not an enum -- same reasoning as every other
  // lifecycle/category field in this schema (a future third origin must
  // never require a migration). This is what makes it structurally
  // possible to tell a generated preview apart from a real client photo
  // (e.g. so it can never silently become new Analysis evidence) without
  // a second, parallel asset table.
  origin String @default("upload")

  // Technical Visual Map, Stage 5A -- dimensions of the NORMALIZED/STORED
  // bytes this asset actually persists and /content serves (post-EXIF-
  // orientation-correction, post-re-encode), never pre-normalization EXIF
  // dimensions and never a separate "display" size. normalizeImage() in
  // image-normalizer.ts already computes both values at upload time;
  // processImageForStorage() currently discards them before they reach the
  // caller -- threading them through to persistence is Stage 5B's job, not
  // this one (see this migration's own commit message). Nullable, with no
  // mandatory legacy backfill: an existing row with null width/height simply
  // cannot support spatial binding creation later until dimensions exist by
  // some means -- that is a safe, honest "unavailable" state, not an error.
  width  Int?
  height Int?

  uploadedAt         DateTime        @default(now())
  deletedAt          DateTime?
  retentionDeletesAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  analyses           ImageAnalysis[]
  analysisResults    Analysis[]
  // Technical Visual Map, Stage 5A. Virtual back-relation only -- produces no
  // column or constraint here; the (validated, non-FK) pointer lives on
  // TechnicalVisualMapSpatialBinding.sourceImageAssetId, per the Decision
  // Lock's explicit choice to keep this a server-validated pointer rather
  // than a database-enforced relation (see that model's own doc comment).

  @@unique([storageBucketAlias, storageKey])
  @@index([ownerUserId])
  @@index([clientId])
  @@index([ownerUserId, clientId])
  @@index([deletedAt])
  @@index([ownerUserId, storageState, id])
  @@index([storageState, retentionDeletesAt, id])
}

model ImageAnalysis {
  id                         String                         @id @default(uuid())
  assetId                    String
  status                     String                         @default("draft")
  providerName               String                         @default("manual-only")
  modelVersion               String                         @default("mock-1.0")
  analysisPayload            Json                           @default("{}")
  confidences                Json                           @default("{}")
  unknownFields              Json                           @default("[]")
  warnings                   Json                           @default("[]")
  limitations                Json                           @default("[]")
  consentTimestamp           DateTime                       @default(now())
  externalAiConsentGrantedAt DateTime?                      @db.Timestamp(6)
  externalAiConsentVersion   String?                        @db.VarChar(32)
  lastFailureCode            String?                        @db.VarChar(80)
  deletedAt                  DateTime?
