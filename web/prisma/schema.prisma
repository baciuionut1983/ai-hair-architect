generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WebhookDeliveryStatus {
  pending
  dispatching
  delivered
  failed_retryable
  failed_terminal
  canceled
}

enum WebhookAttemptOutcome {
  success
  retryable_failure
  terminal_failure
}

enum WebhookFailureDomain {
  destination
  security
  configuration
  platform_internal
}

enum WebhookFailureCode {
  none
  timeout
  connection_refused
  connection_reset
  host_unreachable
  network_unreachable
  dns_temporary
  dns_not_found
  http_3xx_redirect_blocked
  http_408
  http_425
  http_429
  http_5xx
  http_4xx_non_retryable
  ssrf_blocked
  tls_certificate_error
  invalid_url
  endpoint_disabled
  endpoint_deleted
  internal_transient
  internal_persistent
}

enum OpsBackupRestoreRunStatus {
  started
  completed
  failed
  indeterminate
}

enum OpsBackupRestoreMaintenanceRunStatus {
  running
  completed
  failed
}

enum OpsBackupRestoreRetentionRunStatus {
  running
  completed
  failed
}

enum AppointmentReminderType {
  appointment
  follow_up
  maintenance
}

enum NotificationType {
  appointment
  follow_up
  maintenance
}

model User {
  id            String            @id @default(uuid())
  email         String            @unique
  passwordHash  String
  role          String
  locale        String
  createdAt     DateTime          @default(now())
  sessions      Session[]
  clients       Client[]
  analyses      Analysis[]
  consultations Consultation[]
  appointments  Appointment[]
  notifications Notification[]
  webhooks      WebhookEndpoint[]
}

model Session {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id            String         @id @default(uuid())
  ownerUserId   String
  fullName      String         @db.VarChar(200)
  email         String?        @db.VarChar(320)
  phone         String?        @db.VarChar(40)
  notes         String?        @db.VarChar(4000)
  deletedAt     DateTime?      @db.Timestamp(6)
  createdAt     DateTime       @default(now()) @db.Timestamp(6)
  updatedAt     DateTime       @updatedAt @db.Timestamp(6)
  owner         User           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  analyses      Analysis[]
  consultations Consultation[]
  appointments  Appointment[]

  @@unique([id, ownerUserId])
  @@index([ownerUserId, deletedAt, updatedAt, id])
}

model Analysis {
  id                   String         @id
  clientId             String
  ownerUserId          String
  goal                 String
  hairType             String
  density              String
  porosity             String
  phase                String
  clarificationRound   Int
  confidenceScore      Float
  uncertaintyReasons   Json
  followUpQuestions    Json
  recommendations      Json
  safetyNotes          Json
  faceShape            String?
  headShape            String?
  hairLength           String?
  hairTexture          String?
  hairCondition        String?
  growthPattern        String?
  targetShape          String?
  technicalCutPlan     Json?
  clarificationAnswers Json
  imageAssetId         String?
  imageAnalysisId      String?
  m8DraftCreatedAt     DateTime?
  m8FinalizedAt        DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  owner                User           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client               Client         @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  imageAsset           ImageAsset?    @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  imageAnalysis        ImageAnalysis? @relation(fields: [imageAnalysisId], references: [id], onDelete: SetNull)
  consultations        Consultation[]

  @@unique([id, ownerUserId, clientId])
  @@index([ownerUserId])
  @@index([clientId])
  @@index([ownerUserId, clientId])
  @@index([imageAssetId])
  @@index([imageAnalysisId])
}

model Consultation {
  id          String   @id @default(uuid())
  ownerUserId String
  clientId    String
  analysisId  String
  summary     String   @db.VarChar(4000)
  nextSteps   Json     @default("[]")
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  client      Client   @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  analysis    Analysis @relation(fields: [analysisId, ownerUserId, clientId], references: [id, ownerUserId, clientId], onDelete: Restrict)

  @@index([ownerUserId, createdAt, id])
  @@index([ownerUserId, clientId, createdAt, id])
  @@index([analysisId, ownerUserId, clientId])
}

model Appointment {
  id                    String                  @id @default(uuid())
  ownerUserId           String
  clientId              String
  title                 String                  @db.VarChar(200)
  startsAt              DateTime                @db.Timestamp(6)
  reminderMinutesBefore Int                     @default(1440)
  reminderType          AppointmentReminderType
  reminderSentAt        DateTime?               @db.Timestamp(6)
  notes                 String                  @default("") @db.VarChar(4000)
  createdAt             DateTime                @default(now()) @db.Timestamp(6)
  updatedAt             DateTime                @updatedAt @db.Timestamp(6)
  owner                 User                    @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client                Client                  @relation(fields: [clientId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  notifications         Notification[]

  @@unique([id, ownerUserId, clientId])
  @@index([ownerUserId, startsAt, id])
  @@index([ownerUserId, clientId, startsAt, id])
  @@index([ownerUserId, reminderSentAt, startsAt, id])
}

model Notification {
  id                   String           @id @default(uuid())
  ownerUserId          String
  type                 NotificationType
  title                String           @db.VarChar(240)
  message              String           @db.VarChar(1000)
  relatedClientId      String
  relatedAppointmentId String
  createdAt            DateTime         @default(now()) @db.Timestamp(6)
  readAt               DateTime?        @db.Timestamp(6)
  owner                User             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  relatedAppointment   Appointment      @relation(fields: [relatedAppointmentId, ownerUserId, relatedClientId], references: [id, ownerUserId, clientId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([relatedAppointmentId, ownerUserId, type])
  @@index([ownerUserId, createdAt, id])
  @@index([ownerUserId, readAt, createdAt, id])
}

model ImageAsset {
  id                    String          @id @default(uuid())
  fileName              String
  mimeType              String
  sizeBytes             Int
  ownerUserId           String
  clientId              String
  storagePath           String
  exifStripped          Boolean         @default(false)
  normalizedOrientation Int             @default(0)
  uploadedAt            DateTime        @default(now())
  deletedAt             DateTime?
  retentionDeletesAt    DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  analyses              ImageAnalysis[]
  analysisResults       Analysis[]

  @@index([ownerUserId])
  @@index([clientId])
  @@index([ownerUserId, clientId])
  @@index([deletedAt])
}

model ImageAnalysis {
  id                 String                @id @default(uuid())
  assetId            String
  status             String                @default("draft")
  providerName       String                @default("manual-only")
  modelVersion       String                @default("mock-1.0")
  analysisPayload    Json                  @default("{}")
  confidences        Json                  @default("{}")
  unknownFields      Json                  @default("[]")
  warnings           Json                  @default("[]")
  limitations        Json                  @default("[]")
  consentTimestamp   DateTime              @default(now())
  deletedAt          DateTime?
  retentionDeletesAt DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  asset              ImageAsset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reviews            ImageAnalysisReview[]
  analysisResults    Analysis[]

  @@index([assetId])
  @@index([status])
  @@index([deletedAt])
}

model ImageAnalysisReview {
  id                    String        @id @default(uuid())
  analysisId            String
  reviewedByUserId      String
  manualCorrections     Json          @default("{}")
  confirmationTimestamp DateTime?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  analysis              ImageAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([reviewedByUserId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String   @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  status       String
  metadata     Json
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
  @@index([status])
  @@index([actorUserId, createdAt])
}

model OpsBackupSnapshot {
  id                String   @id @default(cuid())
  ownerUserId       String   @db.Uuid
  label             String   @db.VarChar(120)
  snapshotJson      Json
  checksum          String   @db.VarChar(64)
  checksumAlgorithm String   @db.VarChar(32)
  schemaVersion     String   @db.VarChar(16)
  createdByUserId   String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamp(6)

  @@index([ownerUserId, createdAt])
}

model OpsBackupRestoreRun {
  id                               String                    @id @default(cuid())
  ownerUserId                      String                    @db.Uuid
  backupId                         String                    @db.VarChar(120)
  actorUserId                      String                    @db.Uuid
  correlationRequestId             String                    @db.VarChar(120)
  strategy                         String                    @db.VarChar(32)
  previewFingerprint               String                    @db.VarChar(64)
  currentStateFingerprint          String                    @db.VarChar(64)
  status                           OpsBackupRestoreRunStatus
  attemptCount                     Int                       @default(0)
  maxAttempts                      Int                       @default(3)
  startedAt                        DateTime                  @db.Timestamp(6)
  finishedAt                       DateTime?                 @db.Timestamp(6)
  finalErrorCode                   String?                   @db.VarChar(80)
  deletedClientCount               Int?
  deletedAnalysisCount             Int?
  deletedImageAssetCount           Int?
  deletedImageAnalysisCount        Int?
  deletedImageAnalysisReviewCount  Int?
  restoredClientCount              Int?
  restoredAnalysisCount            Int?
  restoredImageAssetCount          Int?
  restoredImageAnalysisCount       Int?
  restoredImageAnalysisReviewCount Int?
  warningCodes                     Json?
  createdAt                        DateTime                  @default(now()) @db.Timestamp(6)
  updatedAt                        DateTime                  @updatedAt @db.Timestamp(6)

  @@index([ownerUserId, startedAt, id])
  @@index([ownerUserId, status, startedAt, id])
  @@index([ownerUserId, status, finishedAt, id])
  @@index([ownerUserId, backupId, startedAt, id])
  @@index([ownerUserId, correlationRequestId, startedAt, id])
}

model OpsBackupRestoreMaintenanceRun {
  id                                String                               @id @default(cuid())
  ownerUserId                       String                               @db.Uuid
  actorUserId                       String                               @db.Uuid
  status                            OpsBackupRestoreMaintenanceRunStatus
  staleThresholdMinutes             Int
  evaluationTime                    DateTime                             @db.Timestamp(6)
  maintenanceFingerprint            String                               @db.VarChar(64)
  executionIdempotencyKey           String                               @db.VarChar(190)
  idempotencyFingerprint            String                               @db.VarChar(64)
  advisoryLockKey                   String                               @db.VarChar(32)
  candidatesScanned                 Int                                  @default(0)
  candidatesReconciledIndeterminate Int                                  @default(0)
  finalErrorCode                    String?                              @db.VarChar(80)
  startedAt                         DateTime                             @db.Timestamp(6)
  finishedAt                        DateTime?                            @db.Timestamp(6)
  createdAt                         DateTime                             @default(now()) @db.Timestamp(6)
  updatedAt                         DateTime                             @updatedAt @db.Timestamp(6)

  @@unique([ownerUserId, executionIdempotencyKey])
  @@index([ownerUserId, status, startedAt])
  @@index([ownerUserId, status, finishedAt, id])
  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, evaluationTime])
}

model OpsBackupRestoreRetentionRun {
  id                           String                             @id @default(cuid())
  ownerUserId                  String                             @db.Uuid
  actorUserId                  String                             @db.Uuid
  status                       OpsBackupRestoreRetentionRunStatus
  policyVersion                String                             @db.VarChar(32)
  batchLimit                   Int
  evaluationTime               DateTime                           @db.Timestamp(6)
  retentionFingerprint         String                             @db.VarChar(64)
  executionIdempotencyKey      String                             @db.VarChar(190)
  idempotencyFingerprint       String                             @db.VarChar(64)
  advisoryLockKey              String                             @db.VarChar(32)
  candidateRestoreRunCount     Int                                @default(0)
  candidateMaintenanceRunCount Int                                @default(0)
  deletedRestoreRunCount       Int                                @default(0)
  deletedMaintenanceRunCount   Int                                @default(0)
  finalErrorCode               String?                            @db.VarChar(80)
  startedAt                    DateTime                           @db.Timestamp(6)
  finishedAt                   DateTime?                          @db.Timestamp(6)
  createdAt                    DateTime                           @default(now()) @db.Timestamp(6)
  updatedAt                    DateTime                           @updatedAt @db.Timestamp(6)

  @@unique([ownerUserId, executionIdempotencyKey])
  @@index([ownerUserId, status, startedAt])
  @@index([ownerUserId, evaluationTime])
  @@index([ownerUserId, createdAt])
}

model OpsRetentionRun {
  id                      String    @id @default(cuid())
  ownerUserId             String    @db.Uuid
  mode                    String    @db.VarChar(16)
  status                  String    @db.VarChar(32)
  olderThanDays           Int
  reasonAuditSafe         String?   @db.VarChar(200)
  executionIdempotencyKey String?   @db.VarChar(190)
  idempotencyFingerprint  String?   @db.VarChar(64)
  advisoryLockKey         String    @db.VarChar(32)
  startedAt               DateTime  @db.Timestamp(6)
  finishedAt              DateTime? @db.Timestamp(6)
  pushQueueAffected       Int
  auditEventsAffected     Int
  errorCode               String?   @db.VarChar(80)
  errorMessageSafe        String?   @db.VarChar(500)
  createdAt               DateTime  @default(now()) @db.Timestamp(6)

  @@unique([ownerUserId, executionIdempotencyKey])
  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, startedAt])
}

model OpsPushQueueEntry {
  id          String    @id @default(cuid())
  ownerUserId String    @db.Uuid
  channel     String    @db.VarChar(16)
  title       String    @db.VarChar(160)
  body        String    @db.Text
  status      String    @db.VarChar(16)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  processedAt DateTime? @db.Timestamp(6)

  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, status])
}

model WebhookEndpoint {
  id              String    @id @default(cuid())
  ownerUserId     String
  owner           User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name            String    @db.VarChar(255)
  url             String    @db.VarChar(2048)
  // Deprecated compatibility field retained only for M9D route compatibility.
  // M10A introduces WebhookEndpointSecretVersion.secretEncrypted as the forward-compatible
  // source of truth for secret material. This legacy column is planned for removal only
  // after all routes have migrated to the versioned secret model in a later milestone.
  secretEncrypted String    @db.Text
  enabled         Boolean   @default(true)
  deletedAt       DateTime? @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @db.Timestamp(6)

  secretVersions WebhookEndpointSecretVersion[]
  deliveries     WebhookDelivery[]

  @@unique([ownerUserId, name])
  @@unique([id, ownerUserId])
  @@index([ownerUserId])
  @@index([ownerUserId, enabled])
  @@index([ownerUserId, enabled, deletedAt])
}

model WebhookEndpointSecretVersion {
  id                String    @id @default(cuid())
  webhookEndpointId String
  ownerUserId       String
  version           Int
  // This is the new forward-compatible encrypted secret store introduced in M10A.
  // New delivery records bind to a specific secret version through a composite FK.
  secretEncrypted   String    @db.Text
  // The hardcoded default is intentional: M9D already signs with HMAC-SHA256 using the v1 canonical format,
  // so backfilled and newly created version rows must agree on the same explicit scheme string.
  signatureScheme   String    @default("hmac_sha256_v1") @db.VarChar(64)
  isCurrent         Boolean   @default(false)
  createdAt         DateTime  @default(now()) @db.Timestamp(6)
  retiredAt         DateTime? @db.Timestamp(6)
  retainUntil       DateTime? @db.Timestamp(6)

  endpoint   WebhookEndpoint   @relation(fields: [webhookEndpointId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  deliveries WebhookDelivery[]

  @@unique([id, webhookEndpointId, ownerUserId])
  @@unique([webhookEndpointId, version])
  @@index([webhookEndpointId, createdAt])
  @@index([ownerUserId, retainUntil])
}

model WebhookEvent {
  id                     String   @id @default(cuid())
  ownerUserId            String
  eventType              String   @db.VarChar(120)
  schemaVersion          String   @db.VarChar(16)
  producerIdempotencyKey String?  @db.VarChar(190)
  resourceType           String   @db.VarChar(80)
  resourceId             String   @db.VarChar(120)
  occurredAt             DateTime @db.Timestamp(6)
  payload                Json
  dispatchEligible       Boolean
  auditOnly              Boolean
  sensitivity            String   @db.VarChar(32)
  createdAt              DateTime @default(now()) @db.Timestamp(6)

  deliveries WebhookDelivery[]

  @@unique([id, ownerUserId])
  @@index([ownerUserId, createdAt])
  @@index([eventType, occurredAt])
}

model WebhookDelivery {
  id                      String                @id @default(cuid())
  ownerUserId             String
  webhookEventId          String
  webhookEndpointId       String
  secretVersionId         String
  status                  WebhookDeliveryStatus @default(pending)
  attemptCount            Int                   @default(0)
  maxAttempts             Int                   @default(6)
  connectivityMaxAttempts Int                   @default(3)
  nextAttemptAt           DateTime?             @db.Timestamp(6)
  lastAttemptAt           DateTime?             @db.Timestamp(6)
  deliveredAt             DateTime?             @db.Timestamp(6)
  failedTerminalAt        DateTime?             @db.Timestamp(6)
  leaseToken              String?               @db.VarChar(120)
  leaseExpiresAt          DateTime?             @db.Timestamp(6)
  lastFailureDomain       WebhookFailureDomain?
  lastFailureCode         WebhookFailureCode    @default(none)
  idempotencyKey          String                @db.VarChar(190)
  targetUrlSnapshot       String                @db.VarChar(2048)
  signatureSchemeSnapshot String                @db.VarChar(64)
  secretVersionSnapshot   Int
  eventTypeSnapshot       String                @db.VarChar(120)
  approvedHeadersSnapshot Json?
  createdAt               DateTime              @default(now()) @db.Timestamp(6)
  updatedAt               DateTime              @updatedAt @db.Timestamp(6)

  event         WebhookEvent                 @relation(fields: [webhookEventId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  endpoint      WebhookEndpoint              @relation(fields: [webhookEndpointId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict)
  secretVersion WebhookEndpointSecretVersion @relation(fields: [secretVersionId, webhookEndpointId, ownerUserId], references: [id, webhookEndpointId, ownerUserId], onDelete: Restrict)
  attempts      WebhookDeliveryAttempt[]

  @@unique([webhookEndpointId, webhookEventId])
  @@unique([ownerUserId, idempotencyKey])
  @@index([ownerUserId, status, nextAttemptAt])
  @@index([ownerUserId, failedTerminalAt])
  @@index([ownerUserId, leaseExpiresAt])
  @@index([webhookEndpointId, createdAt])
  @@index([secretVersionId])
}

model WebhookDeliveryAttempt {
  id                String                 @id @default(cuid())
  webhookDeliveryId String
  attemptNumber     Int
  startedAt         DateTime               @db.Timestamp(6)
  completedAt       DateTime?              @db.Timestamp(6)
  durationMs        Int?
  httpStatus        Int?
  outcome           WebhookAttemptOutcome?
  failureDomain     WebhookFailureDomain?
  failureCode       WebhookFailureCode?
  errorCode         String?                @db.VarChar(80)
  errorMessageSafe  String?                @db.VarChar(500)
  responseTruncated Boolean                @default(false)
  createdAt         DateTime               @default(now()) @db.Timestamp(6)

  delivery WebhookDelivery @relation(fields: [webhookDeliveryId], references: [id], onDelete: Restrict)

  @@unique([webhookDeliveryId, attemptNumber])
  @@index([webhookDeliveryId, attemptNumber])
  @@index([createdAt])
}
