  "definitions": [
    {
      "definitionId": "haircutting.elevation.definition",
      "conceptId": "haircutting.elevation",
      "text": "Elevation is the angle at which a selected hair strand or subsection is lifted and held relative to the shape/curvature of the head during haircutting.",
      "scope": "[NEEDS PROFESSIONAL VALIDATION]",
      "distinguishFrom": [
        "haircutting.projection",
        "haircutting.overdirection",
        "haircutting.cuttingAngle",
        "haircutting.cuttingLine",
        "haircutting.guide"
      ],
      "sourceLanguage": "en",
      "provenance": {
        "sourceId": "T1_6_2_C_2B_PROFESSIONALLY_VALIDATED_CANONICAL_DEFINITIONS#professional-input",
        "authorityType": "CONFIRMED",
        "reviewedAt": "2026-09-24"
      },
      "specificationVersion": "1.2.0-t162c2b",
      "specificationDigest": "sha256:7c7ddda22a2073fe744a02d902f11bcb572c1f11f1d0a22fde0e910d3d607ef3"
    },
    {
      "definitionId": "haircutting.section.definition",
      "conceptId": "haircutting.section",
      "text": "A section is a larger deliberately separated working area of the hair/head used to organize and execute the haircut.",
      "scope": "[NEEDS PROFESSIONAL VALIDATION]",
      "distinguishFrom": [
        "haircutting.parting",
        "haircutting.subsection",
        "haircutting.subsectioning"
      ],
      "sourceLanguage": "en",
      "provenance": {
        "sourceId": "T1_6_2_C_2B_PROFESSIONALLY_VALIDATED_CANONICAL_DEFINITIONS#professional-input",
        "authorityType": "CONFIRMED",
        "reviewedAt": "2026-09-24"
      },
      "specificationVersion": "1.2.0-t162c2b",
      "specificationDigest": "sha256:8fb9c7b975b4214ab26c9ac847aa89fdbdbc2b01f3261fffee0c5564d515fbe7"
    },
    {
      "definitionId": "haircutting.subsection.definition",
      "conceptId": "haircutting.subsection",
      "text": "A subsection is a smaller working portion or strand selected from within a larger section for the actual cutting/work operation. Multiple subsections may be worked successively across a section.",
      "scope": "[NEEDS PROFESSIONAL VALIDATION]",
      "distinguishFrom": [
        "haircutting.section",
        "haircutting.subsectioning",
        "haircutting.parting"
      ],
      "sourceLanguage": "en",
      "provenance": {
        "sourceId": "T1_6_2_C_2B_PROFESSIONALLY_VALIDATED_CANONICAL_DEFINITIONS#professional-input",
        "authorityType": "CONFIRMED",
        "reviewedAt": "2026-09-24"
      },
      "specificationVersion": "1.2.0-t162c2b",
      "specificationDigest": "sha256:dad9ce7950aaf0ac6bfce8b635911e00526e24646c794b3d2e8c28a48b20cb1c"
    },
    {
      "definitionId": "haircutting.subsectioning.definition",
      "conceptId": "haircutting.subsectioning",
      "text": "Subsectioning is the process of dividing/selecting smaller working subsections from within a larger section so they can be worked successively.",
      "scope": "[NEEDS PROFESSIONAL VALIDATION]",
      "distinguishFrom": [
        "haircutting.subsection"
      ],
      "sourceLanguage": "en",
      "provenance": {
        "sourceId": "T1_6_2_C_2B_PROFESSIONALLY_VALIDATED_CANONICAL_DEFINITIONS#professional-input",
        "authorityType": "CONFIRMED",
        "reviewedAt": "2026-09-24"
      },
      "specificationVersion": "1.2.0-t162c2b",
      "specificationDigest": "sha256:59a96847acf75e102587a038c2f980b6cb3a586c136165146d78a8add2022f79"
    },
    {
      "definitionId": "haircutting.parting.definition",
      "conceptId": "haircutting.parting",
      "text": "A parting is the line/separation used to divide sections or subsections.",
      "scope": "[NEEDS PROFESSIONAL VALIDATION]",
      "distinguishFrom": [
        "haircutting.section",
        "haircutting.subsection",
        "haircutting.sectioning"
      ],
      "sourceLanguage": "en",
      "provenance": {
        "sourceId": "T1_6_2_C_2B_PROFESSIONALLY_VALIDATED_CANONICAL_DEFINITIONS#professional-input",
        "authorityType": "CONFIRMED",
        "reviewedAt": "2026-09-24"
      },
      "specificationVersion": "1.2.0-t162c2b",
      "specificationDigest": "sha256:7f3be54e550d7f450ecccd287b791a10ea9c3c4564180fbfccca8a9e16341865"
    },
    {
      "definitionId": "haircutting.projection.definition",
      "conceptId": "haircutting.projection",
      "text": "Projection is the directional positioning of a selected strand in the direction or angular position in which it is intended to be worked or cut.",
      "scope": "[NEEDS PROFESSIONAL VALIDATION]",
      "distinguishFrom": [
        "haircutting.elevation"
      ],
