    {
      "definitionId": "haircutting.guide.definition",
      "conceptId": "haircutting.guide",
      "text": "A haircutting guide is a previously established hair strand/reference that determines the cutting length/reference for subsequent hair. The guide provides the reference from which subsequent cutting continues.",
